@model IEnumerable<LaptopShop.Models.Order>

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    string currentStatus = ViewBag.CurrentStatus as string;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="fa-solid fa-cart-shopping text-primary me-2"></i>Quản lý Đơn hàng</h3>
            <p class="text-muted small mb-0">Xem và cập nhật trạng thái các đơn hàng trong hệ thống.</p>
        </div>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Thanh Lọc trạng thái -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body py-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="fw-bold me-2"><i class="fa-solid fa-filter me-1"></i>Lọc trạng thái:</span>
                <a href="/Admin/Orders" class="btn btn-sm @(string.IsNullOrEmpty(currentStatus) ? "btn-primary" : "btn-outline-secondary")">Tất cả</a>
                <a href="/Admin/Orders?status=Pending" class="btn btn-sm @(currentStatus == "Pending" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary")">Chờ xử lý</a>
                <a href="/Admin/Orders?status=Confirmed" class="btn btn-sm @(currentStatus == "Confirmed" ? "btn-info text-white fw-bold" : "btn-outline-secondary")">Đã xác nhận</a>
                <a href="/Admin/Orders?status=Shipping" class="btn btn-sm @(currentStatus == "Shipping" ? "btn-primary fw-bold" : "btn-outline-secondary")">Đang giao</a>
                <a href="/Admin/Orders?status=Delivered" class="btn btn-sm @(currentStatus == "Delivered" ? "btn-success fw-bold" : "btn-outline-secondary")">Đã giao</a>
                <a href="/Admin/Orders?status=Cancelled" class="btn btn-sm @(currentStatus == "Cancelled" ? "btn-danger fw-bold" : "btn-outline-secondary")">Đã hủy</a>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách đơn hàng -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Mã ĐH</th>
                            <th>Khách hàng</th>
                            <th>SĐT</th>
                            <th>Tổng tiền</th>
                            <th>Ngày đặt</th>
                            <th style="width: 180px;">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                // Đọc thuộc tính an toàn bằng Reflection
                                var name = item.GetType().GetProperty("FullName")?.GetValue(item)
                                        ?? item.GetType().GetProperty("CustomerName")?.GetValue(item)
                                        ?? item.GetType().GetProperty("ReceiverName")?.GetValue(item)
                                        ?? "Khách hàng";

                                var phone = item.GetType().GetProperty("PhoneNumber")?.GetValue(item)
                                         ?? item.GetType().GetProperty("Phone")?.GetValue(item)
                                         ?? "";

                                var dateObj = item.GetType().GetProperty("CreatedAt")?.GetValue(item)
                                           ?? item.GetType().GetProperty("OrderDate")?.GetValue(item)
                                           ?? item.GetType().GetProperty("CreatedDate")?.GetValue(item);
                                string dateStr = dateObj != null ? Convert.ToDateTime(dateObj).ToString("dd/MM/yyyy HH:mm") : "";

                                var totalObj = item.GetType().GetProperty("TotalAmount")?.GetValue(item)
                                            ?? item.GetType().GetProperty("TotalPrice")?.GetValue(item);
                                decimal totalVal = totalObj != null ? Convert.ToDecimal(totalObj) : 0;

                                string statusVal = Convert.ToString(item.Status);

                                <tr>
                                    <td><strong>#@item.Id</strong></td>
                                    <td class="fw-bold">@name</td>
                                    <td>@phone</td>
                                    <td class="text-danger fw-bold">@totalVal.ToString("N0") đ</td>
                                    <td><small class="text-muted">@dateStr</small></td>
                                    <td>
                                        <form asp-area="Admin" asp-controller="Orders" asp-action="UpdateStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                                                <option value="Pending" selected="@(statusVal == "Pending")">Chờ xử lý</option>
                                                <option value="Confirmed" selected="@(statusVal == "Confirmed")">Đã xác nhận</option>
                                                <option value="Shipping" selected="@(statusVal == "Shipping")">Đang giao hàng</option>
                                                <option value="Delivered" selected="@(statusVal == "Delivered")">Đã giao hàng</option>
                                                <option value="Cancelled" selected="@(statusVal == "Cancelled")">Đã hủy</option>
                                            </select>
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm me-1" title="Xem chi tiết">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="PrintInvoice" asp-route-id="@item.Id" target="_blank" class="btn btn-outline-secondary btn-sm" title="In hóa đơn">
                                            <i class="fa-solid fa-print"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fa-regular fa-folder-open fa-2x mb-2 d-block"></i>
                                    Chưa có đơn hàng nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>