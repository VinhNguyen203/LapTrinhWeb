@model LaptopShop.Helpers.PaginatedList<LaptopShop.Models.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-cart-shopping me-2 text-primary"></i>Quản lý Đơn hàng</h3>
        <span class="text-muted small">Hệ thống theo dõi & quản lý các đơn đặt hàng từ khách hàng</span>
    </div>
</div>

<!-- Alert messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc & Tìm kiếm -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="searchString" class="form-control" 
                           placeholder="Tìm theo mã đơn, họ tên, SĐT hoặc địa chỉ..." 
                           value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.StatusFilter) ? "selected" : null)">-- Tất cả trạng thái --</option>
                    <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending" ? "selected" : null)">Chờ xử lý (Pending)</option>
                    <option value="Processing" selected="@(ViewBag.StatusFilter == "Processing" ? "selected" : null)">Đang giao (Processing)</option>
                    <option value="Completed" selected="@(ViewBag.StatusFilter == "Completed" ? "selected" : null)">Hoàn thành (Completed)</option>
                    <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled" ? "selected" : null)">Đã hủy (Cancelled)</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3">
                    <i class="fa-solid fa-filter me-1"></i>Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-right me-1"></i>Đặt lại
                </a>
                <span class="ms-auto align-self-center text-muted small">
                    Tổng: <strong>@Model.TotalCount</strong> đơn hàng
                </span>
            </div>
        </form>
    </div>
</div>

<!-- Bảng dữ liệu đơn hàng -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 80px;">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Địa chỉ giao hàng</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày đặt</th>
                        <th class="text-center" style="width: 170px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-box-open fs-1 d-block mb-3 text-secondary"></i>
                                Không tìm thấy đơn hàng nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@order.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar me-2" 
                                             style="width: 36px; height: 36px; border-radius: 50%; background: #6366f1; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.9rem;">
                                            @(string.IsNullOrEmpty(order.CustomerName) ? "K" : order.CustomerName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@(string.IsNullOrEmpty(order.CustomerName) ? "Khách vãng lai" : order.CustomerName)</div>
                                            @if (!string.IsNullOrEmpty(order.UserId))
                                            {
                                                <small class="text-muted">User ID: @order.UserId</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><code>@(string.IsNullOrEmpty(order.PhoneNumber) ? "-" : order.PhoneNumber)</code></td>
                                <td>
                                    <small class="text-secondary d-block text-truncate" style="max-width: 200px;" title="@order.ShippingAddress">
                                        @(string.IsNullOrEmpty(order.ShippingAddress) ? "-" : order.ShippingAddress)
                                    </small>
                                </td>
                                <td>
                                    <span class="fw-bold text-danger">
                                        @(order.TotalAmount.HasValue ? order.TotalAmount.Value.ToString("N0") : "0") đ
                                    </span>
                                </td>
                                <td>
                                    @switch (order.Status)
                                    {
                                        case "Completed":
                                            <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                                <i class="fa-solid fa-circle-check me-1"></i>Hoàn thành
                                            </span>
                                            break;
                                        case "Processing":
                                            <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1">
                                                <i class="fa-solid fa-truck-fast me-1"></i>Đang giao
                                            </span>
                                            break;
                                        case "Cancelled":
                                            <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                                <i class="fa-solid fa-ban me-1"></i>Đã hủy
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-warning-subtle text-warning border border-warning px-2 py-1">
                                                <i class="fa-solid fa-clock me-1"></i>Chờ xử lý
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="text-muted small">
                                    @(order.OrderDate.HasValue ? order.OrderDate.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <!-- Xem chi tiết -->
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-info" title="Xem chi tiết đơn hàng">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        <!-- Đổi trạng thái nhanh -->
                                        <button type="button" class="btn btn-outline-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" title="Cập nhật trạng thái">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            <li><h6 class="dropdown-header small">Cập nhật trạng thái</h6></li>
                                            <li>
                                                <form asp-action="UpdateStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@order.Id" />
                                                    <input type="hidden" name="newStatus" value="Pending" />
                                                    <button type="submit" class="dropdown-item text-warning">
                                                        <i class="fa-solid fa-clock me-2"></i>Chờ xử lý
                                                    </button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-action="UpdateStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@order.Id" />
                                                    <input type="hidden" name="newStatus" value="Processing" />
                                                    <button type="submit" class="dropdown-item text-primary">
                                                        <i class="fa-solid fa-truck me-2"></i>Đang giao hàng
                                                    </button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-action="UpdateStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@order.Id" />
                                                    <input type="hidden" name="newStatus" value="Completed" />
                                                    <button type="submit" class="dropdown-item text-success">
                                                        <i class="fa-solid fa-circle-check me-2"></i>Đã hoàn thành
                                                    </button>
                                                </form>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <form asp-action="UpdateStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@order.Id" />
                                                    <input type="hidden" name="newStatus" value="Cancelled" />
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="fa-solid fa-ban me-2"></i>Hủy đơn hàng
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>

                                        <!-- Nút Xóa -->
                                        <form asp-action="Delete" asp-route-id="@order.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa đơn hàng">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Phân trang -->
@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">
            Trang <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong>
        </span>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-statusFilter="@ViewBag.StatusFilter">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-pageNumber="@i"
                           asp-route-searchString="@ViewBag.CurrentSearch"
                           asp-route-statusFilter="@ViewBag.StatusFilter">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-statusFilter="@ViewBag.StatusFilter">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
