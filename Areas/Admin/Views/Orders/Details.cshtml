@model LaptopShop.Models.Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Chi tiết Đơn hàng #{Model.Id}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i>Chi tiết Đơn hàng #@Model.Id</h3>
        <span class="text-muted small">Thời gian đặt: @(Model.OrderDate.HasValue ? Model.OrderDate.Value.ToString("dd/MM/yyyy HH:mm:ss") : "-")</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách
        </a>
        <button type="button" class="btn btn-outline-primary" onclick="window.print()">
            <i class="fa-solid fa-print me-1"></i>In đơn hàng
        </button>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Thông tin khách hàng & Giao hàng -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 mb-4 rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-user me-2 text-primary"></i>Thông tin Khách hàng</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="text-muted small d-block">Họ và tên người nhận</label>
                    <span class="fw-bold fs-6">@(string.IsNullOrEmpty(Model.CustomerName) ? "Chưa cập nhật" : Model.CustomerName)</span>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Số điện thoại liên hệ</label>
                    <span class="fw-semibold">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</span>
                </div>
                <div class="mb-3">
                    <label class="text-muted small d-block">Địa chỉ nhận hàng</label>
                    <span class="text-secondary">@(string.IsNullOrEmpty(Model.ShippingAddress) ? "Nhận tại cửa hàng" : Model.ShippingAddress)</span>
                </div>
                <div class="mb-0">
                    <label class="text-muted small d-block">Tài khoản đặt hàng</label>
                    <span class="badge bg-light text-dark border">User ID: @(Model.UserId ?? "Khách vãng lai")</span>
                </div>
            </div>
        </div>

        <!-- Trạng thái đơn hàng -->
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>Cập nhật Trạng thái</h6>
            </div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label small text-muted">Trạng thái hiện tại</label>
                        <select name="newStatus" class="form-select">
                            <option value="Pending" selected="@(Model.Status == "Pending" ? "selected" : null)">Chờ xử lý (Pending)</option>
                            <option value="Processing" selected="@(Model.Status == "Processing" ? "selected" : null)">Đang giao hàng (Processing)</option>
                            <option value="Completed" selected="@(Model.Status == "Completed" ? "selected" : null)">Đã hoàn thành (Completed)</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled" ? "selected" : null)">Đã hủy (Cancelled)</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Lưu trạng thái
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Cột phải: Danh sách sản phẩm trong đơn -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-box me-2 text-primary"></i>Danh sách Sản phẩm đã mua</h6>
                <span class="badge bg-secondary-subtle text-secondary">@Model.OrderDetails.Count mặt hàng</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3" style="width: 60px;">#</th>
                                <th>Tên sản phẩm</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-center" style="width: 100px;">Số lượng</th>
                                <th class="text-end pe-3">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.OrderDetails.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Không có chi tiết sản phẩm.</td>
                                </tr>
                            }
                            else
                            {
                                int idx = 1;
                                foreach (var item in Model.OrderDetails)
                                {
                                    decimal lineTotal = (item.UnitPrice ?? 0) * (item.Quantity ?? 0);
                                    <tr>
                                        <td class="ps-3 text-muted">@(idx++)</td>
                                        <td>
                                            <div class="fw-semibold text-dark">
                                                @(item.Product != null ? item.Product.Name : $"Sản phẩm #{item.ProductId}")
                                            </div>
                                            <small class="text-muted">Mã SP: #@item.ProductId</small>
                                        </td>
                                        <td class="text-end">
                                            @((item.UnitPrice ?? 0).ToString("N0")) đ
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark border px-2 py-1">x @(item.Quantity ?? 0)</span>
                                        </td>
                                        <td class="text-end pe-3 fw-bold text-danger">
                                            @lineTotal.ToString("N0") đ
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-bold fs-6">Tổng cộng tiền hàng:</td>
                                <td class="text-end pe-3 fw-extrabold text-danger fs-5">
                                    @(Model.TotalAmount.HasValue ? Model.TotalAmount.Value.ToString("N0") : "0") đ
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
