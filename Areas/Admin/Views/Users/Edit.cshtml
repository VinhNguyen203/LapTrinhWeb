@model LaptopShop.Models.AppUser
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Chỉnh sửa người dùng";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary me-3">
        <i class="fa-solid fa-arrow-left"></i>
    </a>
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-user-pen me-2 text-warning"></i>Chỉnh sửa tài khoản người dùng</h3>
        <span class="text-muted small">Cập nhật thông tin và phân quyền cho tài khoản #@Model.Id</span>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-pen-to-square me-2"></i>Thông tin tài khoản</h5>
            </div>
            <div class="card-body p-4">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <!-- Họ tên -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">
                            <i class="fa-solid fa-user me-1 text-primary"></i>Họ và tên <span class="text-danger">*</span>
                        </label>
                        <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Email (Chỉ đọc) -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="fa-solid fa-envelope me-1 text-primary"></i>Địa chỉ Email
                        </label>
                        <input type="text" class="form-control bg-light" value="@Model.Email" readonly disabled />
                        <div class="form-text text-muted">Email là định danh tài khoản, không thể thay đổi.</div>
                    </div>

                    <div class="row">
                        <!-- Số điện thoại -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">
                                <i class="fa-solid fa-phone me-1 text-primary"></i>Số điện thoại
                            </label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0987654321" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <!-- Vai trò -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Role" class="form-label fw-semibold">
                                <i class="fa-solid fa-shield-halved me-1 text-primary"></i>Vai trò (Role) <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Role" class="form-select">
                                <option value="Customer">Customer (Khách hàng)</option>
                                <option value="Admin">Admin (Quản trị viên)</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Địa chỉ -->
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold">
                            <i class="fa-solid fa-location-dot me-1 text-primary"></i>Địa chỉ giao hàng
                        </label>
                        <textarea asp-for="Address" class="form-control" rows="2" placeholder="Nhập địa chỉ người dùng..."></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <!-- Trạng thái hoạt động -->
                    <div class="mb-4 p-3 bg-light rounded border">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="isActiveSwitch">
                            <label class="form-check-label fw-semibold" for="isActiveSwitch">
                                Kích hoạt tài khoản (Cho phép đăng nhập)
                            </label>
                        </div>
                        <small class="text-muted d-block mt-1">Nếu tắt, người dùng sẽ không thể đăng nhập vào hệ thống.</small>
                    </div>

                    <!-- Nút bấm -->
                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fa-solid fa-xmark me-1"></i>Hủy
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                            <i class="fa-solid fa-eye me-1"></i>Chi tiết
                        </a>
                        <button type="submit" class="btn btn-warning px-4 fw-semibold">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
