@model LaptopShop.Helpers.PaginatedList<LaptopShop.Models.AppUser>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-users-gear me-2 text-primary"></i>Quản lý Tài khoản & Người dùng</h3>
        <span class="text-muted small">Hệ thống phân quyền & danh sách tài khoản thành viên</span>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fa-solid fa-user-plus me-1"></i>Thêm người dùng mới
    </a>
</div>

<!-- Alert messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc & Tìm kiếm -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="searchString" class="form-control" 
                           placeholder="Tìm theo họ tên, email hoặc số điện thoại..." 
                           value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="roleFilter" class="form-select" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.RoleFilter) ? "selected" : null)">-- Tất cả vai trò --</option>
                    <option value="Admin" selected="@(ViewBag.RoleFilter == "Admin" ? "selected" : null)">Admin (Quản trị viên)</option>
                    <option value="Customer" selected="@(ViewBag.RoleFilter == "Customer" ? "selected" : null)">Customer (Khách hàng)</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3">
                    <i class="fa-solid fa-filter me-1"></i>Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-right me-1"></i>Đặt lại
                </a>
                <span class="ms-auto align-self-center text-muted small">
                    Tổng: <strong>@Model.TotalCount</strong> tài khoản
                </span>
            </div>
        </form>
    </div>
</div>

<!-- Bảng dữ liệu người dùng -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-center" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users-slash fs-1 d-block mb-3 text-secondary"></i>
                                Không tìm thấy người dùng nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@user.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar me-2" 
                                             style="width: 36px; height: 36px; border-radius: 50%; background: @(user.Role == "Admin" ? "#dc3545" : "#0d6efd"); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.9rem;">
                                            @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-semibold">@user.FullName</div>
                                            @if (!string.IsNullOrEmpty(user.Address))
                                            {
                                                <small class="text-muted d-block text-truncate" style="max-width: 200px;">@user.Address</small>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><code>@user.Email</code></td>
                                <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "-" : user.PhoneNumber)</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger"><i class="fa-solid fa-shield-halved me-1"></i>Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary"><i class="fa-solid fa-user me-1"></i>Customer</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            <i class="fa-solid fa-circle-check me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                            <i class="fa-solid fa-lock me-1"></i>Bị khóa
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-outline-info" title="Xem chi tiết">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái tài khoản này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary" title="@(user.IsActive ? "Khóa tài khoản" : "Mở khóa")">
                                                <i class="fa-solid @(user.IsActive ? "fa-lock" : "fa-lock-open")"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-outline-danger" title="Xóa tài khoản">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Phân trang -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(Model.PageIndex - 1)"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   asp-route-roleFilter="@ViewBag.RoleFilter">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pageNumber="@i"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-roleFilter="@ViewBag.RoleFilter">@i</a>
                </li>
            }

            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageNumber="@(Model.PageIndex + 1)"
                   asp-route-searchString="@ViewBag.CurrentSearch"
                   asp-route-roleFilter="@ViewBag.RoleFilter">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            </li>
        </ul>
        <div class="text-center text-muted small">
            Trang @Model.PageIndex / @Model.TotalPages (Hiển thị 10 tài khoản / trang)
        </div>
    </nav>
}
