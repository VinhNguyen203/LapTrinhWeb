@{
    ViewData["Title"] = "Trang Chủ Quản Trị (Dashboard)";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-tachometer-alt me-2 text-primary"></i>Bảng Điều Khiển Hệ Thống</h1>
            <p class="text-muted small mb-0">Tổng quan số liệu kinh doanh và biểu đồ thống kê của LaptopShop.</p>
        </div>
    </div>

    <!-- 4 Thẻ Thống Kê Số Liệu (Cards) -->
    <div class="row">
        <!-- Doanh thu -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow-sm h-100 py-2 border-0 border-start border-4 border-primary">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Doanh Thu (Hoàn Thành)</div>
                            <div class="h5 mb-0 font-weight-bold text-dark">@string.Format("{0:N0}", ViewBag.TotalRevenue) VNĐ</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Đơn hàng chờ xử lý -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow-sm h-100 py-2 border-0 border-start border-4 border-warning">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Đơn Chờ Xử Lý (Pending)</div>
                            <div class="h5 mb-0 font-weight-bold text-dark">@ViewBag.PendingOrdersCount đơn</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tổng sản phẩm -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow-sm h-100 py-2 border-0 border-start border-4 border-success">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Tổng Sản Phẩm Laptop</div>
                            <div class="h5 mb-0 font-weight-bold text-dark">@ViewBag.ActiveProductsCount máy</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-laptop fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Khách hàng -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card shadow-sm h-100 py-2 border-0 border-start border-4 border-info">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Khách Hàng Đã Mua</div>
                            <div class="h5 mb-0 font-weight-bold text-dark">@ViewBag.TotalCustomers người</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Khu Vực Biểu Đồ Thống Kê -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-header bg-white py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-chart-bar me-1"></i> Thống Kê Doanh Thu Theo Ngày</h6>
                </div>
                <div class="card-body">
                    <div class="chart-area" style="height: 380px;">
                        <canvas id="revenueBarChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const apiUrl = '@Url.Action("GetRevenueChartData", "Dashboard", new { area = "Admin" })';

            fetch(apiUrl)
                .then(response => response.json())
                .then(data => {
                    let labels = data.map(item => item.date || item.Date);
                    let revenues = data.map(item => item.revenue || item.Revenue);

                    if (data.length === 0) {
                        labels = ['Hôm nay'];
                        revenues = [30000000];
                    }

                    const ctx = document.getElementById('revenueBarChart').getContext('2d');
                    new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: 'Doanh thu (VNĐ)',
                                data: revenues,
                                backgroundColor: 'rgba(78, 115, 223, 0.85)',
                                borderColor: 'rgba(78, 115, 223, 1)',
                                borderWidth: 1,
                                borderRadius: 6,
                                maxBarThickness: 65 // Giúp cột không bị bè rộng ra toàn màn hình khi có ít dữ liệu
                            }]
                        },
                        options: {
                            maintainAspectRatio: false,
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(value) {
                                            return value.toLocaleString('vi-VN') + ' đ';
                                        }
                                    }
                                }
                            },
                            plugins: {
                                tooltip: {
                                    callbacks: {
                                        label: function(context) {
                                            let value = context.raw || 0;
                                            return ' Doanh thu: ' + value.toLocaleString('vi-VN') + ' VNĐ';
                                        }
                                    }
                                }
                            }
                        }
                    });
                })
                .catch(error => console.error('Lỗi tải dữ liệu biểu đồ:', error));
        });
    </script>
}