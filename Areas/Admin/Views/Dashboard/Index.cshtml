@{
    ViewData["Title"] = "Trang Chủ Quản Trị (Dashboard)";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var topSelling = ViewBag.TopSellingProducts as IEnumerable<dynamic>;
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Trang Chủ Quản Trị (Dashboard)</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Tổng quan số liệu kinh doanh và biểu đồ thống kê của LaptopShop.</li>
    </ol>

    <!-- 4 Thẻ số liệu thống kê -->
    <div class="row">
        <div class="col-xl-3 col-md-6">
            <div class="card bg-primary text-white mb-4 shadow-sm">
                <div class="card-body">
                    <div class="small text-uppercase fw-bold">Doanh Thu (Hoàn Thành)</div>
                    <div class="h3 mb-0">@string.Format("{0:N0}", ViewBag.MonthlyRevenue ?? 0) VNĐ</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <small>Tính trong tháng hiện tại</small>
                    <i class="fas fa-dollar-sign"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-warning text-dark mb-4 shadow-sm">
                <div class="card-body">
                    <div class="small text-uppercase fw-bold">Đơn Chờ Xử Lý (Pending)</div>
                    <div class="h3 mb-0">@(ViewBag.PendingOrdersCount ?? 0) đơn</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="text-dark stretched-link text-decoration-none" asp-area="Admin" asp-controller="Orders" asp-action="Index">Xem chi tiết</a>
                    <i class="fas fa-shopping-cart"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-success text-white mb-4 shadow-sm">
                <div class="card-body">
                    <div class="small text-uppercase fw-bold">Tổng Sản Phẩm Laptop</div>
                    <div class="h3 mb-0">@(ViewBag.ActiveProductsCount ?? 0) máy</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <a class="text-white stretched-link text-decoration-none" asp-area="Admin" asp-controller="Products" asp-action="Index">Quản lý kho</a>
                    <i class="fas fa-laptop"></i>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card bg-info text-white mb-4 shadow-sm">
                <div class="card-body">
                    <div class="small text-uppercase fw-bold">Khách Hàng Mới Trong Tháng</div>
                    <div class="h3 mb-0">@(ViewBag.NewCustomersCount ?? 0) người</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between">
                    <small>Đăng ký tài khoản</small>
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Cảnh báo hàng tồn kho thấp nếu có -->
    @if (ViewBag.LowStockCount != null && (int)ViewBag.LowStockCount > 0)
    {
        <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center justify-content-between shadow-sm mb-4 border-warning" role="alert">
            <div>
                <i class="fas fa-triangle-exclamation fa-lg me-2 text-warning"></i>
                <strong>Cảnh báo tồn kho:</strong> Phát hiện <strong>@(ViewBag.LowStockCount)</strong> mẫu laptop có tồn kho thấp (&lt; 5 máy).
            </div>
            <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="btn btn-warning btn-sm fw-bold shadow-sm">
                <i class="fas fa-boxes-stacked me-1"></i> Kiểm tra &amp; Nhập kho ngay
            </a>
        </div>
    }

    <!-- Khu vực biểu đồ và Top 5 sản phẩm -->
    <div class="row">
        <!-- Biểu đồ doanh thu -->
        <div class="col-xl-8">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
                    <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-chart-line me-1"></i> Thống Kê Doanh Thu Theo Thời Gian</h6>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" id="btn7d" class="btn btn-outline-primary active" onclick="loadRevenueChart('7d')">7 Ngày gần nhất</button>
                        <button type="button" id="btn12m" class="btn btn-outline-primary" onclick="loadRevenueChart('12m')">12 Tháng</button>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" width="100%" height="45"></canvas>
                </div>
            </div>
        </div>

        <!-- Top 5 sản phẩm bán chạy -->
        <div class="col-xl-4">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="m-0 font-weight-bold text-success"><i class="fas fa-fire me-1"></i> Top 5 Sản Phẩm Bán Chạy</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead class="table-light fs-7">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">Đã bán</th>
                                    <th class="text-end">Doanh thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (topSelling != null && topSelling.Any())
                                {
                                    foreach (var item in topSelling)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-truncate" style="max-width: 140px;" title="@item.ProductName">@item.ProductName</td>
                                            <td class="text-center"><span class="badge bg-success">@item.TotalQuantity</span></td>
                                            <td class="text-end text-success fw-bold">@string.Format("{0:N0}", item.TotalRevenue)đ</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-3 text-muted">Chưa có dữ liệu bán hàng.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng 2: Biểu đồ cơ cấu thị phần hãng & Thông tin thống kê nhanh -->
    <div class="row">
        <!-- Biểu đồ thương hiệu (Doughnut Chart) -->
        <div class="col-xl-6">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3 border-bottom">
                    <h6 class="m-0 font-weight-bold text-info"><i class="fas fa-chart-pie me-1"></i> Thị Phần Theo Thương Hiệu Laptop</h6>
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" id="btnShareRev" class="btn btn-outline-info active" onclick="loadBrandChart('revenue')">Theo Doanh thu</button>
                        <button type="button" id="btnShareQty" class="btn btn-outline-info" onclick="loadBrandChart('quantity')">Theo Số lượng</button>
                    </div>
                </div>
                <div class="card-body">
                    <div style="max-height: 280px; position: relative;">
                        <canvas id="brandChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Thẻ tóm tắt nhanh và liên kết tiện ích -->
        <div class="col-xl-6">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-bolt me-1 text-warning"></i> Thao Tác Nhanh & Báo Cáo</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="p-3 border rounded bg-light text-center h-100">
                                <div class="text-muted small fw-bold mb-1">TỔNG DOANH THU TOÀN THỜI GIAN</div>
                                <div class="h5 fw-bold text-primary mb-2">@string.Format("{0:N0}", ViewBag.TotalAllTimeRevenue ?? 0) đ</div>
                                <a asp-area="Admin" asp-controller="Reports" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-file-excel me-1"></i> Xuất báo cáo
                                </a>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-3 border rounded bg-light text-center h-100">
                                <div class="text-muted small fw-bold mb-1">CẢNH BÁO TỒN KHO</div>
                                <div class="h5 fw-bold @((ViewBag.LowStockCount ?? 0) > 0 ? "text-danger" : "text-success") mb-2">
                                    @(ViewBag.LowStockCount ?? 0) mẫu cần nhập
                                </div>
                                <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="btn btn-outline-warning btn-sm text-dark">
                                    <i class="fas fa-boxes-stacked me-1"></i> Xem kho chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-info mt-3 mb-0 py-2 small">
                        <i class="fas fa-info-circle me-1"></i> Số liệu và biểu đồ được cập nhật tự động từ các giao dịch đơn hàng thực tế trong cơ sở dữ liệu.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let revenueChartInstance = null;
        let brandChartInstance = null;

        function loadRevenueChart(range) {
            document.getElementById('btn7d').classList.toggle('active', range === '7d');
            document.getElementById('btn12m').classList.toggle('active', range === '12m');

            fetch('/Admin/Dashboard/GetRevenueData?range=' + range)
                .then(response => response.json())
                .then(data => {
                    const ctx = document.getElementById('revenueChart').getContext('2d');
                    if (revenueChartInstance) {
                        revenueChartInstance.destroy();
                    }

                    revenueChartInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: data.labels,
                            datasets: [{
                                label: 'Doanh thu (VNĐ)',
                                data: data.data,
                                backgroundColor: 'rgba(13, 110, 253, 0.08)',
                                borderColor: 'rgba(13, 110, 253, 1)',
                                borderWidth: 2.5,
                                fill: true,
                                tension: 0.35,
                                pointBackgroundColor: 'rgba(13, 110, 253, 1)',
                                pointRadius: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        callback: function(value) {
                                            return value.toLocaleString('vi-VN') + ' đ';
                                        }
                                    }
                                }
                            }
                        }
                    });
                })
                .catch(err => console.error("Lỗi tải biểu đồ doanh thu:", err));
        }

        function loadBrandChart(type) {
            document.getElementById('btnShareRev').classList.toggle('active', type === 'revenue');
            document.getElementById('btnShareQty').classList.toggle('active', type === 'quantity');

            fetch('/Admin/Dashboard/GetBrandShareData?type=' + type)
                .then(response => response.json())
                .then(data => {
                    const ctx = document.getElementById('brandChart').getContext('2d');
                    if (brandChartInstance) {
                        brandChartInstance.destroy();
                    }

                    const colors = [
                        '#0d6efd', '#6610f2', '#6f42c1', '#d63384',
                        '#dc3545', '#fd7e14', '#ffc107', '#198754',
                        '#20c997', '#0dcaf0'
                    ];

                    brandChartInstance = new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: data.labels,
                            datasets: [{
                                data: data.data,
                                backgroundColor: colors.slice(0, data.labels.length)
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'right'
                                }
                            }
                        }
                    });
                })
                .catch(err => console.error("Lỗi tải biểu đồ thương hiệu:", err));
        }

        document.addEventListener("DOMContentLoaded", function () {
            loadRevenueChart('7d');
            loadBrandChart('revenue');
        });
    </script>
}