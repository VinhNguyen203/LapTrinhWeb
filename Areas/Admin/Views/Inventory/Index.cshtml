@model IEnumerable<LaptopShop.Models.Product>

@{
    ViewData["Title"] = "Quản lý tồn kho";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int lowThreshold = ViewBag.LowStockThreshold ?? 5;
    var brands = ViewBag.Brands as List<LaptopShop.Models.Brand>;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
        <div>
            <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-boxes-stacked me-2 text-primary"></i>Quản Lý Tồn Kho Sản Phẩm</h1>
            <p class="text-muted small mb-0">Theo dõi số lượng tồn kho theo thời gian thực, cảnh báo sắp hết và nhập hàng nhanh.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-primary btn-sm"><i class="fas fa-sync-alt me-1"></i> Làm mới</a>
        </div>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- 4 Thẻ KPI Tồn Kho -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-primary border-4 bg-white">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Tổng Mẫu Laptop</div>
                            <div class="h4 mb-0 fw-bold text-primary">@(ViewBag.TotalProducts ?? 0)</div>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 text-primary">
                            <i class="fas fa-laptop fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-info border-4 bg-white">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Tổng Máy Trong Kho</div>
                            <div class="h4 mb-0 fw-bold text-info">@string.Format("{0:N0}", ViewBag.TotalStockUnits ?? 0)</div>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-circle p-3 text-info">
                            <i class="fas fa-warehouse fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-warning border-4 bg-white">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Sắp Hết Hàng (&lt; 5)</div>
                            <div class="h4 mb-0 fw-bold text-warning">@(ViewBag.LowStockCount ?? 0)</div>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-circle p-3 text-warning">
                            <i class="fas fa-triangle-exclamation fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm border-start border-danger border-4 bg-white">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Đã Hết Hàng (= 0)</div>
                            <div class="h4 mb-0 fw-bold text-danger">@(ViewBag.OutOfStockCount ?? 0)</div>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-circle p-3 text-danger">
                            <i class="fas fa-ban fa-lg"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Khung tìm kiếm và lọc -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body bg-light rounded">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-start-0" placeholder="Tìm tên laptop..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="brandId" class="form-select">
                        <option value="">-- Tất cả hãng --</option>
                        @if (brands != null)
                        {
                            foreach (var b in brands)
                            {
                                if (ViewBag.CurrentBrandId != null && (int)ViewBag.CurrentBrandId == b.Id)
                                {
                                    <option value="@b.Id" selected="selected">@b.Name</option>
                                }
                                else
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="stockStatus" class="form-select">
                        <option value="all" selected='@(ViewBag.CurrentStockStatus == "all")'>-- Tất cả trạng thái kho --</option>
                        <option value="low" selected='@(ViewBag.CurrentStockStatus == "low")'>⚠️ Sắp hết hàng (&lt; 5 máy)</option>
                        <option value="out" selected='@(ViewBag.CurrentStockStatus == "out")'>⛔ Đã hết hàng (0 máy)</option>
                        <option value="available" selected='@(ViewBag.CurrentStockStatus == "available")'>✅ Tồn kho ổn định (&ge; 5)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1"><i class="fas fa-filter me-1"></i> Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại"><i class="fas fa-redo"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách tồn kho -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-warehouse me-1"></i> Danh sách kho hàng chi tiết</h6>
            <span class="badge bg-secondary">@(Model?.Count() ?? 0) sản phẩm</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-uppercase fs-7">
                        <tr>
                            <th class="ps-4" style="width: 80px;">Mã SP</th>
                            <th>Tên Sản Phẩm Laptop</th>
                            <th>Cấu Hình (CPU/RAM)</th>
                            <th>Hãng</th>
                            <th>Danh Mục</th>
                            <th>Giá Bán</th>
                            <th class="text-center">Tồn Kho</th>
                            <th class="text-end pe-4">Thao Tác Nhập Nhanh</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                bool isOutOfStock = item.StockQuantity == 0;
                                bool isLowStock = item.StockQuantity < lowThreshold;
                                string rowClass = isOutOfStock ? "table-danger bg-danger bg-opacity-10" : (isLowStock ? "table-warning bg-warning bg-opacity-10" : "");

                                <tr class="@rowClass">
                                    <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                                    <td class="fw-semibold">
                                        @item.Name
                                        @if (isOutOfStock)
                                        {
                                            <span class="badge bg-danger ms-2"><i class="fas fa-ban me-1"></i> Hết hàng</span>
                                        }
                                        else if (isLowStock)
                                        {
                                            <span class="badge bg-warning text-dark ms-2"><i class="fas fa-exclamation-triangle me-1"></i> Sắp hết (&lt; @lowThreshold)</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@(string.IsNullOrEmpty(item.CPU) ? "N/A" : item.CPU) / @(string.IsNullOrEmpty(item.RAM) ? "N/A" : item.RAM)</small>
                                    </td>
                                    <td><span class="badge bg-secondary bg-opacity-75">@(item.Brand?.Name ?? "N/A")</span></td>
                                    <td>@(item.Category?.Name ?? "N/A")</td>
                                    <td class="text-success fw-bold">@item.Price.ToString("N0") VNĐ</td>
                                    <td class="text-center">
                                        <span class="fs-6 fw-bold @(isOutOfStock ? "text-danger" : (isLowStock ? "text-warning" : "text-dark"))">
                                            @item.StockQuantity
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="QuickImport" method="post" class="d-inline-flex align-items-center justify-content-end gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.Id" />
                                            <input type="number" name="addQuantity" value="10" min="1" max="1000" class="form-control form-control-sm text-center" style="width: 75px;" title="Số lượng nhập thêm" />
                                            <button type="submit" class="btn btn-success btn-sm text-nowrap shadow-sm">
                                                <i class="fas fa-plus-circle me-1"></i> Nhập thêm
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy sản phẩm tồn kho nào phù hợp.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>