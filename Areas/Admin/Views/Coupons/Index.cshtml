@model LaptopShop.Helpers.PaginatedList<LaptopShop.Models.Coupon>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Mã giảm giá";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-ticket me-2 text-primary"></i>Quản lý Mã giảm giá & Khuyến mãi</h3>
        <span class="text-muted small">Hệ thống phát hành & quản lý voucher ưu đãi cho khách hàng</span>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm px-3">
        <i class="fa-solid fa-plus me-1"></i>Thêm mã giảm giá
    </a>
</div>

<!-- Alert messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc & Tìm kiếm -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="searchString" class="form-control" 
                           placeholder="Tìm theo mã voucher hoặc mô tả..." 
                           value="@ViewBag.CurrentSearch" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(ViewBag.StatusFilter) ? "selected" : null)">-- Tất cả trạng thái --</option>
                    <option value="Active" selected="@(ViewBag.StatusFilter == "Active" ? "selected" : null)">Đang hoạt động (Active)</option>
                    <option value="Inactive" selected="@(ViewBag.StatusFilter == "Inactive" ? "selected" : null)">Hết hạn / Đã tắt (Inactive)</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3">
                    <i class="fa-solid fa-filter me-1"></i>Lọc
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-rotate-right me-1"></i>Đặt lại
                </a>
                <span class="ms-auto align-self-center text-muted small">
                    Tổng: <strong>@Model.TotalCount</strong> mã
                </span>
            </div>
        </form>
    </div>
</div>

<!-- Bảng dữ liệu mã giảm giá -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;">ID</th>
                        <th>Mã giảm giá</th>
                        <th>Mức giảm</th>
                        <th>Đơn tối thiểu</th>
                        <th>Lượt sử dụng</th>
                        <th>Hạn dùng</th>
                        <th>Trạng thái</th>
                        <th class="text-center" style="width: 170px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-ticket-simple fs-1 d-block mb-3 text-secondary"></i>
                                Không tìm thấy mã giảm giá nào phù hợp.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var coupon in Model)
                        {
                            bool isExpired = coupon.ExpiryDate < DateTime.Now;
                            <tr>
                                <td class="fw-bold text-muted">#@coupon.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="me-2">
                                            <span class="badge bg-primary-subtle text-primary border border-primary px-2 py-1 fs-6 font-monospace">
                                                <i class="fa-solid fa-tag me-1"></i>@coupon.Code
                                            </span>
                                        </div>
                                        <div>
                                            <small class="text-muted d-block text-truncate" style="max-width: 200px;" title="@coupon.Description">
                                                @coupon.Description
                                            </small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="fw-bold text-danger">
                                        @if (coupon.DiscountType == "Percent" || coupon.DiscountType == "Percentage")
                                        {
                                            <span>-@coupon.DiscountValue.ToString("0")%</span>
                                        }
                                        else
                                        {
                                            <span>-@coupon.DiscountValue.ToString("N0") đ</span>
                                        }
                                    </span>
                                </td>
                                <td>
                                    <span class="text-secondary small">
                                        @(coupon.MinOrderAmount > 0 ? $"Từ {coupon.MinOrderAmount.ToString("N0")} đ" : "Không giới hạn")
                                    </span>
                                </td>
                                <td>
                                    <div class="small">
                                        <span class="fw-semibold">@coupon.UsageCount</span> / <span class="text-muted">@coupon.MaxUsage</span>
                                    </div>
                                    <div class="progress" style="height: 4px; width: 80px;">
                                        <div class="progress-bar bg-success" role="progressbar" 
                                             style="width: @(coupon.MaxUsage > 0 ? (coupon.UsageCount * 100 / coupon.MaxUsage) : 0)%"></div>
                                    </div>
                                </td>
                                <td>
                                    <span class="small @(isExpired ? "text-danger fw-bold" : "text-muted")">
                                        @coupon.ExpiryDate.ToString("dd/MM/yyyy")
                                        @if (isExpired)
                                        {
                                            <span class="badge bg-danger-subtle text-danger ms-1">Hết hạn</span>
                                        }
                                    </span>
                                </td>
                                <td>
                                    @if (coupon.IsActive && !isExpired)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                                            <i class="fa-solid fa-circle-check me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                                            <i class="fa-solid fa-lock me-1"></i>Đã tắt
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <!-- Chỉnh sửa -->
                                        <a asp-action="Edit" asp-route-id="@coupon.Id" class="btn btn-outline-warning" title="Chỉnh sửa mã">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        <!-- Bật/Tắt trạng thái -->
                                        <form asp-action="ToggleStatus" asp-route-id="@coupon.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn đổi trạng thái mã giảm giá này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-secondary" title="@(coupon.IsActive ? "Vô hiệu hóa" : "Kích hoạt")">
                                                <i class="fa-solid @(coupon.IsActive ? "fa-lock" : "fa-lock-open")"></i>
                                            </button>
                                        </form>

                                        <!-- Xóa -->
                                        <form asp-action="Delete" asp-route-id="@coupon.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa mã giảm giá này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa mã">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Phân trang -->
@if (Model.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">
            Trang <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong>
        </span>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-statusFilter="@ViewBag.StatusFilter">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-pageNumber="@i"
                           asp-route-searchString="@ViewBag.CurrentSearch"
                           asp-route-statusFilter="@ViewBag.StatusFilter">@i</a>
                    </li>
                }
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" 
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-searchString="@ViewBag.CurrentSearch"
                       asp-route-statusFilter="@ViewBag.StatusFilter">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
}
