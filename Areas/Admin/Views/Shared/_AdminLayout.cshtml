<!-- Phần của Tú: _AdminLayout (sidebar có chỗ trống để mỗi người gắn menu) -->
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin CPanel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="admin-sidebar" style="width: 250px;">
            <div class="p-3 text-center border-bottom border-secondary mb-3">
                <h4 class="text-white fw-bold mb-0">ADMIN PANEL</h4>
                <small class="text-muted">LaptopShop System</small>
            </div>
            <ul class="nav flex-column mb-auto">
                <!-- Phần của Huân: Dashboard & Kho -->
                <li class="nav-item">
                    <a href="/Admin/Dashboard" class="nav-link"><i class="fa-solid fa-chart-pie me-2"></i> Tổng quan</a>
                </li>
                <li class="nav-item">
                    <a href="/Admin/Inventory" class="nav-link"><i class="fa-solid fa-boxes-stacked me-2"></i> Quản lý Kho</a>
                </li>
                
                <!-- Phần của Khoa: Sản phẩm, Hãng, Danh mục -->
                <li class="nav-item mt-3">
                    <small class="px-3 text-uppercase text-muted fw-bold">Danh mục & Sản phẩm</small>
                    <a href="/Admin/Products" class="nav-link mt-2"><i class="fa-solid fa-laptop me-2"></i> Sản phẩm</a>
                    <a href="/Admin/Categories" class="nav-link"><i class="fa-solid fa-list me-2"></i> Danh mục</a>
                </li>

                <!-- Phần của Hưng: Đơn hàng & Đánh giá -->
                <li class="nav-item mt-3">
                    <small class="px-3 text-uppercase text-muted fw-bold">Kinh doanh</small>
                    <a href="/Admin/Orders" class="nav-link mt-2"><i class="fa-solid fa-cart-flatbed me-2"></i> Đơn hàng</a>
                    <a href="/Admin/Reviews" class="nav-link"><i class="fa-solid fa-star me-2"></i> Đánh giá</a>
                </li>

                <!-- Phần của Vinh: Mã giảm giá -->
                <li class="nav-item mt-3">
                    <small class="px-3 text-uppercase text-muted fw-bold">Khuyến mãi</small>
                    <a href="/Admin/Coupons" class="nav-link mt-2"><i class="fa-solid fa-ticket me-2"></i> Mã giảm giá</a>
                </li>

                <!-- Phần của Tú: Tài khoản -->
                <li class="nav-item mt-3">
                    <small class="px-3 text-uppercase text-muted fw-bold">Hệ thống</small>
                    <a href="/Admin/Users" class="nav-link mt-2"><i class="fa-solid fa-users me-2"></i> Người dùng</a>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="flex-grow-1">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom px-4 shadow-sm">
                <div class="container-fluid">
                    <span class="navbar-brand mb-0 h1">@ViewData["Title"]</span>
                    <div class="d-flex">
                        <a href="/" class="btn btn-outline-secondary btn-sm me-2">Ra website</a>
                        <button class="btn btn-danger btn-sm">Đăng xuất</button>
                    </div>
                </div>
            </nav>
            <main class="p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Phần của Huân: Nhúng sẵn Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>