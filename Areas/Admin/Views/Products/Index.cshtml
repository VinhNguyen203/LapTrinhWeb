@model IEnumerable<LaptopShop.Models.Product>
@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? (Model?.Count() ?? 0);
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-laptop me-2 text-primary"></i>Quản lý Danh sách Sản phẩm</h4>
        <span class="text-muted small">Tổng cộng: <strong class="text-primary">@totalItems</strong> sản phẩm trong hệ thống</span>
    </div>
    <a href="/Admin/Products/Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold">
        <i class="fa-solid fa-plus-circle me-2"></i>Thêm sản phẩm mới
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Bộ lọc & Tìm kiếm -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3 bg-white rounded-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-lg-4 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm theo tên, CPU, RAM..." value="@ViewBag.Search" />
                </div>
            </div>
            <div class="col-lg-3 col-md-3">
                <select name="brandId" class="form-select" asp-items="ViewBag.Brands">
                    <option value="">-- Tất cả Hãng sản xuất --</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-3">
                <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                    <option value="">-- Tất cả Danh mục --</option>
                </select>
            </div>
            <div class="col-lg-2 col-md-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold"><i class="fa-solid fa-filter me-1"></i>Lọc</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.BrandId != null || ViewBag.CategoryId != null)
                {
                    <a href="/Admin/Products" class="btn btn-outline-secondary" title="Đặt lại bộ lọc"><i class="fa-solid fa-rotate-left"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng hiển thị sản phẩm -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase text-secondary" style="font-size: 0.85rem;">
                    <tr>
                        <th class="ps-3" style="width: 60px;">ID</th>
                        <th>Tên sản phẩm</th>
                        <th>Hãng</th>
                        <th>Danh mục</th>
                        <th>Cấu hình (RAM / CPU / GPU)</th>
                        <th class="text-end">Giá bán</th>
                        <th class="text-center" style="width: 120px;">Tồn kho</th>
                        <th class="text-center pe-3" style="width: 130px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 text-muted fw-bold small">#@item.Id</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="me-2 text-primary">
                                            <i class="fa-solid fa-laptop fa-lg"></i>
                                        </div>
                                        <div>
                                            <a href="/Products/Details/@item.Id" target="_blank" class="fw-bold text-dark text-decoration-none hover-primary" title="Xem trên web">
                                                @item.Name
                                            </a>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 rounded-pill">
                                        @(item.Brand?.Name ?? "Chưa gán")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill">
                                        @(item.Category?.Name ?? "Chưa gán")
                                    </span>
                                </td>
                                <td>
                                    <div class="small">
                                        <span class="badge bg-light text-dark border me-1"><i class="fa-solid fa-memory me-1 text-info"></i>@(item.RAM ?? "N/A")</span>
                                        <span class="badge bg-light text-dark border me-1"><i class="fa-solid fa-microchip me-1 text-warning"></i>@(item.CPU ?? "N/A")</span>
                                        @if (!string.IsNullOrEmpty(item.GPU))
                                        {
                                            <span class="badge bg-light text-muted border"><i class="fa-solid fa-tv me-1 text-danger"></i>@item.GPU</span>
                                        }
                                    </div>
                                </td>
                                <td class="text-end fw-bold text-danger fs-6">
                                    @item.Price.ToString("N0") VNĐ
                                </td>
                                <td class="text-center">
                                    @if (item.StockQuantity <= 0)
                                    {
                                        <span class="badge bg-danger rounded-pill px-2 py-1">Hết hàng (0)</span>
                                    }
                                    else if (item.StockQuantity < 5)
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-2 py-1">Sắp hết (@item.StockQuantity)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill px-2 py-1">Còn (@item.StockQuantity)</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/Admin/Products/Edit/@item.Id" class="btn btn-outline-warning" title="Chỉnh sửa sản phẩm">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        <form method="post" action="/Admin/Products/Delete/@item.Id" style="display:inline;"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm «@item.Name» (#@item.Id)?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Xóa sản phẩm">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="fa-solid fa-box-open fa-3x text-secondary mb-3 d-block opacity-50"></i>
                                Không tìm thấy sản phẩm nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, page = currentPage - 1 })">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, page = p })">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.Search, brandId = ViewBag.BrandId, categoryId = ViewBag.CategoryId, page = currentPage + 1 })">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>

<style>
    .hover-primary:hover {
        color: #6366f1 !important;
    }
</style>
