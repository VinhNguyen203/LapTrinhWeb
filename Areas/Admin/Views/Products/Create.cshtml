@model LaptopShop.Models.Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Thêm Sản phẩm Mới";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">
        <i class="fa-solid fa-arrow-left me-1"></i>Quay lại danh sách
    </a>
    <h3 class="fw-bold"><i class="fa-solid fa-plus-circle me-2 text-primary"></i>Thêm Sản phẩm Mới</h3>
    <span class="text-muted small">Nhập đầy đủ thông tin kỹ thuật và thông số của máy Laptop</span>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Tên sản phẩm -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên Sản phẩm / Laptop <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Ví dụ: ASUS ROG Zephyrus G14 GA402" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Thương hiệu -->
                        <div class="col-md-6">
                            <label asp-for="BrandId" class="form-label fw-bold">Hãng sản xuất</label>
                            <select asp-for="BrandId" class="form-select" asp-items="ViewBag.BrandId">
                                <option value="">-- Chọn Thương hiệu --</option>
                            </select>
                            <span asp-validation-for="BrandId" class="text-danger small"></span>
                        </div>

                        <!-- Danh mục -->
                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label fw-bold">Danh mục sản phẩm</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                                <option value="">-- Chọn Danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Đơn giá -->
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Price" type="number" step="1000" class="form-control" placeholder="0" required />
                                <span class="input-group-text">đ</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <!-- Tồn kho -->
                        <div class="col-md-6">
                            <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng tồn kho ban đầu <span class="text-danger">*</span></label>
                            <input asp-for="StockQuantity" type="number" min="0" class="form-control" placeholder="0" required />
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h5 class="fw-bold mb-3 text-secondary"><i class="fa-solid fa-microchip me-2"></i>Thông số kỹ thuật phần cứng</h5>

                    <div class="row g-3 mb-3">
                        <!-- CPU -->
                        <div class="col-md-4">
                            <label asp-for="CPU" class="form-label fw-bold">Vi xử lý (CPU)</label>
                            <input asp-for="CPU" class="form-control" placeholder="Intel Core i7-14700HX / Ryzen 7" />
                            <span asp-validation-for="CPU" class="text-danger small"></span>
                        </div>

                        <!-- RAM -->
                        <div class="col-md-4">
                            <label asp-for="RAM" class="form-label fw-bold">Bộ nhớ (RAM)</label>
                            <input asp-for="RAM" class="form-control" placeholder="16GB DDR5 / 32GB" />
                            <span asp-validation-for="RAM" class="text-danger small"></span>
                        </div>

                        <!-- GPU -->
                        <div class="col-md-4">
                            <label asp-for="GPU" class="form-label fw-bold">Card đồ họa (GPU)</label>
                            <input asp-for="GPU" class="form-control" placeholder="RTX 4060 8GB / Iris Xe" />
                            <span asp-validation-for="GPU" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Lưu Sản phẩm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Cột trợ giúp / lưu ý -->
    <div class="col-lg-4">
        <div class="card shadow-sm border-0 bg-light">
            <div class="card-body">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-lightbulb text-warning me-2"></i>Lưu ý khi nhập liệu</h5>
                <ul class="text-secondary small ps-3 mb-0">
                    <li class="mb-2">Tên máy nên bao gồm model, năm sản xuất hoặc mã máy để khách hàng dễ nhận biết.</li>
                    <li class="mb-2">Đơn giá nhập dạng số nguyên VND (hệ thống sẽ tự động định dạng hiển thị).</li>
                    <li class="mb-2">Thông số RAM nên định dạng dạng <strong>8GB, 16GB, 32GB</strong> để hỗ trợ bộ lọc phía khách hàng tìm kiếm chính xác nhất.</li>
                    <li>Sản phẩm sau khi thêm sẽ xuất hiện ngay lập tức trên trang chủ và trang danh mục.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
