@model LaptopShop.Models.Brand
@{
    ViewData["Title"] = "Chỉnh Sửa Hãng Sản Xuất";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1">
                        <li class="breadcrumb-item"><a href="/Admin/Brands" class="text-decoration-none">Hãng sản xuất</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa (#@Model.Id)</li>
                    </ol>
                </nav>
                <h4 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-pen-to-square me-2 text-warning"></i>Chỉnh Sửa Hãng Sản Xuất</h4>
            </div>
            <a href="/Admin/Brands" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-4" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold">Tên Hãng Sản Xuất <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fa-solid fa-building text-muted"></i></span>
                            <input asp-for="Name" class="form-control" autofocus />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/Admin/Brands" class="btn btn-light rounded-pill px-4">Hủy bỏ</a>
                        <button type="submit" class="btn btn-warning text-dark fw-bold rounded-pill px-5 shadow-sm">
                            <i class="fa-solid fa-check me-2"></i>Cập Nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
