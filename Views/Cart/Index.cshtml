@model List<LaptopShop.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <i class="fa-solid fa-cart-shopping fs-3 text-primary me-3"></i>
        <h2 class="fw-bold mb-0">Giỏ Hàng Của Bạn</h2>
    </div>

    @if (TempData["CartSuccess"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="fa-solid fa-circle-check fs-5 me-2 text-success"></i>
            <div class="fw-semibold">@successMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["CartError"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm d-flex align-items-center mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation fs-5 me-2 text-danger"></i>
            <div>@errorMessage</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div id="cart-message"
         class="alert d-none"
         role="status"
         aria-live="polite">
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
            <div class="mb-3 text-muted">
                <i class="fa-solid fa-cart-plus fs-1 opacity-50"></i>
            </div>
            <h4 class="text-muted fw-bold">Giỏ hàng của bạn đang trống!</h4>
            <p class="text-secondary">Hãy dạo một vòng cửa hàng và chọn cho mình chiếc laptop ưng ý nhất nhé.</p>
            <div class="mt-3">
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                    <i class="fa-solid fa-arrow-left me-2"></i> Khám phá sản phẩm ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="cart-table">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th class="text-center" style="width: 150px;">Số lượng</th>
                                    <th class="text-end pe-4">Thành tiền</th>
                                    <th class="text-center" style="width: 80px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr data-product-id="@item.ProductId">
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="p-2 bg-light rounded-3 me-3 text-center" style="width: 50px; height: 50px;">
                                                    <i class="fa-solid fa-laptop text-primary fs-4"></i>
                                                </div>
                                                <div>
                                                    <h6 class="fw-bold mb-0 text-dark">@item.ProductName</h6>
                                                    <small class="text-muted">Mã: #@item.ProductId</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">
                                            @item.UnitPrice.ToString("N0") đ
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex align-items-center justify-content-center gap-1">
                                                <!-- Nút Giảm 1 -->
                                                <form asp-controller="Cart" asp-action="Decrease" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;" title="Giảm 1">
                                                        <i class="fa-solid fa-minus" style="font-size: 0.75rem;"></i>
                                                    </button>
                                                </form>

                                                <!-- Số lượng hiện tại -->
                                                <span class="cart-quantity fw-bold px-3 fs-6">@item.Quantity</span>

                                                <!-- Nút Tăng 1 -->
                                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                                    <input type="hidden" name="quantity" value="1" />
                                                    <button type="submit" class="btn btn-sm btn-outline-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;" title="Tăng 1">
                                                        <i class="fa-solid fa-plus" style="font-size: 0.75rem;"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                        <td class="text-end pe-4 fw-bold text-danger fs-6 cart-line-total">
                                            @item.TotalPrice.ToString("N0") đ
                                        </td>
                                        <td class="text-center">
                                            <form asp-controller="Cart" asp-action="Remove" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <button type="submit" class="btn btn-sm btn-light text-danger rounded-circle shadow-sm" title="Xóa khỏi giỏ">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mt-4">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fa-solid fa-arrow-left me-2"></i> Tiếp tục chọn mua sản phẩm
                    </a>
                </div>
            </div>

            <!-- Tóm tắt đơn hàng -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px;">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Tóm tắt đơn hàng</h5>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng số lượng:</span>
                        <span class="fw-semibold">@Model.Sum(item => item.Quantity) chiếc</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Phí giao hàng:</span>
                        <span class="text-success fw-semibold">Miễn phí</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-5">Tổng thanh toán:</span>
                        <span class="fw-extrabold text-danger fs-4" id="cart-total">
                            @Model.Sum(item => item.TotalPrice).ToString("N0") đ
                        </span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-gradient w-100 py-3 rounded-pill fw-bold fs-6 shadow">
                        <i class="fa-solid fa-credit-card me-2"></i> Tiến Hành Đặt Hàng
                    </a>
                </div>
            </div>
        </div>
    }
</div>