@model LaptopShop.Models.Product

@{
    var originalPrice = Model.Price * 1.15m;
    var isOutOfStock = Model.StockQuantity <= 0;
}

<div class="card card-modern h-100 p-3 border-0 shadow-sm position-relative overflow-hidden" 
     style="border-radius: 20px; background: #ffffff; transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1); border: 1px solid #e2e8f0 !important;">
    
    <!-- Huy hiệu giảm giá & Hãng (Tương phản cao) -->
    <div class="position-absolute top-0 start-0 m-3 z-index-1 d-flex flex-column gap-1">
        <span class="badge text-white px-2 py-1 rounded-pill fw-bold shadow-sm" style="background: #dc2626; font-size: 0.78rem; letter-spacing: 0.5px;">
            -15% GIẢM SỐC
        </span>
        @if (Model.Brand != null)
        {
            <span class="badge text-white px-2 py-1 rounded-pill fw-bold shadow-sm" style="background: #1e293b; font-size: 0.75rem;">
                @Model.Brand.Name
            </span>
        }
    </div>

    <!-- Khung hình ảnh laptop với nền rõ ràng -->
    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">
        <div class="text-center p-4 rounded-4 mb-3 position-relative" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); border: 1px solid #cbd5e1;">
            <div class="py-3">
                <i class="fa-solid fa-laptop text-primary" style="font-size: 65px; filter: drop-shadow(0 8px 12px rgba(79, 70, 229, 0.3)); transition: transform 0.3s;"></i>
            </div>
            <span class="badge bg-dark text-white position-absolute bottom-0 end-0 m-2 px-2 py-1 rounded-3 fw-bold shadow-sm" style="font-size: 0.72rem; background: #0f172a !important;">
                @(Model.Category?.Name ?? "Chính hãng")
            </span>
        </div>
    </a>

    <!-- Thông tin chi tiết với độ tương phản cao -->
    <div class="card-body p-2 d-flex flex-column">
        <div class="mb-1">
            <span class="badge px-2 py-1 rounded-pill fw-bold" style="background: #ede9fe; color: #5b21b6; font-size: 0.75rem;">
                <i class="fa-solid fa-tag me-1"></i>
                @(Model.Category?.Name ?? "Laptop Cao Cấp")
            </span>
        </div>

        <!-- Tên sản phẩm chữ đậm, màu đen tuyền slate-900 rõ ràng -->
        <h5 class="card-title fw-bold mb-2" style="font-size: 1.05rem; min-height: 46px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.35;">
            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none" style="color: #0f172a; font-weight: 800;">
                @Model.Name
            </a>
        </h5>

        <!-- Thông số cấu hình rõ nét, nền sáng tương phản cao -->
        <div class="mb-3 p-2 rounded-3" style="background: #f1f5f9; border: 1px solid #e2e8f0; color: #0f172a; font-size: 0.83rem;">
            <div class="text-truncate mb-1">
                <i class="fa-solid fa-microchip me-1 text-primary"></i><strong>CPU:</strong> <span style="color: #1e293b; font-weight: 600;">@(string.IsNullOrEmpty(Model.CPU) ? "Đang cập nhật" : Model.CPU)</span>
            </div>
            <div class="d-flex justify-content-between text-truncate">
                <span><i class="fa-solid fa-memory me-1 text-info"></i><strong style="color: #0f172a;">RAM @(string.IsNullOrEmpty(Model.RAM) ? "8GB" : Model.RAM)</strong></span>
                <span class="text-truncate"><i class="fa-solid fa-desktop me-1 text-success"></i><strong style="color: #0f172a;">@(string.IsNullOrEmpty(Model.GPU) ? "Onboard" : Model.GPU)</strong></span>
            </div>
        </div>

        <!-- Giá tiền màu đỏ đậm tương phản cao và nút hành động -->
        <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center" style="border-color: #e2e8f0 !important;">
            <div>
                <span class="fw-extrabold fs-5" style="color: #b91c1c; letter-spacing: -0.5px; font-size: 1.2rem !important;">@Model.Price.ToString("N0")đ</span><br/>
                <del class="small fw-semibold text-decoration-line-through" style="color: #64748b;">@originalPrice.ToString("N0")đ</del>
            </div>

            <div class="d-flex gap-1 align-items-center">
                <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" 
                   class="btn btn-outline-dark btn-sm rounded-circle d-flex align-items-center justify-content-center fw-bold" 
                   style="width: 38px; height: 38px; border-color: #cbd5e1; color: #1e293b;" title="Xem chi tiết">
                    <i class="fa-solid fa-eye"></i>
                </a>

                @if (!isOutOfStock)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post" class="js-add-to-cart m-0 p-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" 
                                class="btn rounded-circle shadow-sm d-flex align-items-center justify-content-center text-white border-0" 
                                style="width: 42px; height: 42px; background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); transition: transform 0.2s;" 
                                title="Thêm vào giỏ hàng">
                            <i class="fa-solid fa-cart-plus fs-6"></i>
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-secondary rounded-circle btn-sm disabled" style="width: 38px; height: 38px;" title="Hết hàng">
                        <i class="fa-solid fa-ban"></i>
                    </button>
                }
            </div>
        </div>
    </div>
</div>
