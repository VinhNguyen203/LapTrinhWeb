<!-- Phần của Tú: _Layout (khách) -->
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LaptopShop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index" style="background: var(--primary-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    <i class="fa-solid fa-laptop-code"></i> LAPTOPSHOP
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <!-- Phần của Khoa: Link tới trang Sản phẩm -->
                            <a class="nav-link text-dark" asp-area="" asp-controller="Products" asp-action="Index">Sản Phẩm</a>
                        </li>
                        
                        <!-- ========================================== -->
                        <!-- THÊM PHẦN CỦA HƯNG VÀO ĐÂY -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Orders" asp-action="Index">
                                <i class="fa-solid fa-clipboard-list text-primary"></i> Quản lý Đơn hàng
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Reviews" asp-action="Index">
                                <i class="fa-solid fa-star text-warning"></i> Đánh giá
                            </a>
                        </li>
                        <!-- ========================================== -->
                        
                    </ul>
                    <div class="d-flex align-items-center">
                        <!-- Phần của Vinh: Biểu tượng Giỏ hàng -->
                        <a asp-area="" asp-controller="Cart" asp-action="Index" class="btn btn-light position-relative me-3 rounded-circle shadow-sm">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">3</span>
                        </a>
                        
                        <!-- Phần của Tú: Tài khoản / Đăng nhập -->
                        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-gradient rounded-pill px-4">Đăng nhập</a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4 mb-5 pb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white mt-auto py-4">
        <div class="container text-center">
            &copy; 2026 - LaptopShop - Thiết kế bởi Huân & Team.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>