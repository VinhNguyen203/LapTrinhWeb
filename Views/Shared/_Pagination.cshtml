@model LaptopShop.Models.PaginationInfo

@if (Model != null && Model.TotalPages > 1)
{
    var routeParams = new Dictionary<string, string?>(Model.RouteValues ?? new Dictionary<string, string?>());

    <nav aria-label="Điều hướng trang" class="d-flex justify-content-center my-4">
        <ul class="pagination pagination-md shadow-sm rounded-pill overflow-hidden bg-white p-1">
            <!-- Nút Trước -->
            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                @{
                    routeParams["pageNumber"] = (Model.PageIndex - 1).ToString();
                }
                <a class="page-link border-0 rounded-circle mx-1 d-flex align-items-center justify-content-center" 
                   style="width: 40px; height: 40px;"
                   asp-controller="@Model.Controller" 
                   asp-action="@Model.Action" 
                   asp-all-route-data="routeParams"
                   title="Trang trước">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            </li>

            <!-- Các số trang -->
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                var isCurrent = p == Model.PageIndex;
                routeParams["pageNumber"] = p.ToString();

                <li class="page-item @(isCurrent ? "active" : "")">
                    <a class="page-link border-0 rounded-circle mx-1 d-flex align-items-center justify-content-center fw-bold @(isCurrent ? "text-white" : "text-dark")" 
                       style="width: 40px; height: 40px; @(isCurrent ? "background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);" : "")"
                       asp-controller="@Model.Controller" 
                       asp-action="@Model.Action" 
                       asp-all-route-data="routeParams">
                        @p
                    </a>
                </li>
            }

            <!-- Nút Sau -->
            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                @{
                    routeParams["pageNumber"] = (Model.PageIndex + 1).ToString();
                }
                <a class="page-link border-0 rounded-circle mx-1 d-flex align-items-center justify-content-center" 
                   style="width: 40px; height: 40px;"
                   asp-controller="@Model.Controller" 
                   asp-action="@Model.Action" 
                   asp-all-route-data="routeParams"
                   title="Trang sau">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
