@{
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;

    // Hàm tạo URL giữ lại các tham số query lọc hiện tại
    string GetPageUrl(int page)
    {
        var parameters = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(ViewBag.CurrentSearch as string)) parameters["search"] = ViewBag.CurrentSearch;
        if (ViewBag.CurrentBrandId != null) parameters["brandId"] = ViewBag.CurrentBrandId.ToString();
        if (ViewBag.CurrentCategoryId != null) parameters["categoryId"] = ViewBag.CurrentCategoryId.ToString();
        if (!string.IsNullOrEmpty(ViewBag.CurrentRam as string)) parameters["ram"] = ViewBag.CurrentRam;
        if (ViewBag.CurrentMinPrice != null) parameters["minPrice"] = ViewBag.CurrentMinPrice.ToString();
        if (ViewBag.CurrentMaxPrice != null) parameters["maxPrice"] = ViewBag.CurrentMaxPrice.ToString();
        if (!string.IsNullOrEmpty(ViewBag.CurrentPriceRange as string)) parameters["priceRange"] = ViewBag.CurrentPriceRange;
        if (!string.IsNullOrEmpty(ViewBag.CurrentSort as string)) parameters["sort"] = ViewBag.CurrentSort;
        parameters["page"] = page.ToString();

        var queryString = string.Join("&", parameters.Select(p => $"{p.Key}={System.Net.WebUtility.UrlEncode(p.Value)}"));
        return $"/Products?{queryString}";
    }
}

@if (totalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap gap-1 mb-0">
            <!-- Nút Trang Đầu -->
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link rounded-circle d-flex align-items-center justify-content-center custom-page-btn" 
                   href="@(currentPage == 1 ? "#" : GetPageUrl(1))" title="Trang đầu">
                    <i class="fa-solid fa-angles-left small"></i>
                </a>
            </li>

            <!-- Nút Lùi (Prev) -->
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link rounded-circle d-flex align-items-center justify-content-center custom-page-btn" 
                   href="@(currentPage == 1 ? "#" : GetPageUrl(currentPage - 1))" title="Trang trước">
                    <i class="fa-solid fa-chevron-left small"></i>
                </a>
            </li>

            <!-- Danh sách số trang (thuật toán hiển thị trang xung quanh trang hiện tại) -->
            @{
                int startPage = Math.Max(1, currentPage - 2);
                int endPage = Math.Min(totalPages, currentPage + 2);

                if (startPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link rounded-circle d-flex align-items-center justify-content-center custom-page-btn" href="@GetPageUrl(1)">1</a>
                    </li>
                    if (startPage > 2)
                    {
                        <li class="page-item disabled"><span class="page-link border-0 bg-transparent text-muted">...</span></li>
                    }
                }

                for (int i = startPage; i <= endPage; i++)
                {
                    bool isActive = (i == currentPage);
                    <li class="page-item @(isActive ? "active" : "")">
                        <a class="page-link rounded-circle d-flex align-items-center justify-content-center custom-page-btn @(isActive ? "active-gradient fw-bold text-white shadow-sm" : "")" 
                           href="@GetPageUrl(i)">@i</a>
                    </li>
                }

                if (endPage < totalPages)
                {
                    if (endPage < totalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link border-0 bg-transparent text-muted">...</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link rounded-circle d-flex align-items-center justify-content-center custom-page-btn" href="@GetPageUrl(totalPages)">@totalPages</a>
                    </li>
                }
            }

            <!-- Nút Kế Tiếp (Next) -->
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link rounded-circle d-flex align-items-center justify-content-center custom-page-btn" 
                   href="@(currentPage == totalPages ? "#" : GetPageUrl(currentPage + 1))" title="Trang sau">
                    <i class="fa-solid fa-chevron-right small"></i>
                </a>
            </li>

            <!-- Nút Trang Cuối -->
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link rounded-circle d-flex align-items-center justify-content-center custom-page-btn" 
                   href="@(currentPage == totalPages ? "#" : GetPageUrl(totalPages))" title="Trang cuối">
                    <i class="fa-solid fa-angles-right small"></i>
                </a>
            </li>
        </ul>
        <div class="text-center text-muted small mt-2">
            Trang <strong>@currentPage</strong> / <strong>@totalPages</strong> (Tổng: @totalItems sản phẩm)
        </div>
    </nav>

    <style>
        .custom-page-btn {
            width: 40px;
            height: 40px;
            border-radius: 50% !important;
            border: 1px solid #e2e8f0;
            color: #475569;
            transition: all 0.2s;
        }
        .custom-page-btn:hover {
            background-color: #f1f5f9;
            color: #6366f1;
            border-color: #c7d2fe;
        }
        .active-gradient {
            background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%) !important;
            border-color: transparent !important;
        }
    </style>
}
