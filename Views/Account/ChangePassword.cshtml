@model LaptopShop.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <!-- Tiêu đề trang -->
            <div class="d-flex align-items-center mb-4">
                <i class="bi bi-lock-fill fs-2 text-warning me-3"></i>
                <div>
                    <h2 class="mb-0 fw-bold">Đổi mật khẩu</h2>
                    <small class="text-muted">Cập nhật mật khẩu mới cho tài khoản</small>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-key me-2"></i>Thay đổi mật khẩu</h5>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Mật khẩu hiện tại -->
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold">
                                <i class="bi bi-lock me-1"></i>Mật khẩu hiện tại
                            </label>
                            <div class="input-group">
                                <input asp-for="CurrentPassword" class="form-control"
                                       placeholder="Nhập mật khẩu hiện tại" id="currentPwd" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePwd('currentPwd', 'icon1')">
                                    <i class="bi bi-eye" id="icon1"></i>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <!-- Mật khẩu mới -->
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold">
                                <i class="bi bi-key me-1"></i>Mật khẩu mới
                            </label>
                            <div class="input-group">
                                <input asp-for="NewPassword" class="form-control"
                                       placeholder="Ít nhất 6 ký tự" id="newPwd" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePwd('newPwd', 'icon2')">
                                    <i class="bi bi-eye" id="icon2"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <!-- Xác nhận mật khẩu mới -->
                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">
                                <i class="bi bi-shield-check me-1"></i>Xác nhận mật khẩu mới
                            </label>
                            <div class="input-group">
                                <input asp-for="ConfirmNewPassword" class="form-control"
                                       placeholder="Nhập lại mật khẩu mới" id="confirmPwd" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePwd('confirmPwd', 'icon3')">
                                    <i class="bi bi-eye" id="icon3"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <!-- Nút hành động -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-lg me-2"></i>Đổi mật khẩu
                            </button>
                            <a asp-action="Profile" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Quay lại
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Hiện/ẩn mật khẩu
        function togglePwd(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }
    </script>
}
