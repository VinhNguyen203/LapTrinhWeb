@model int
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 p-5" style="background: #ffffff;">
                <div class="mb-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-success-subtle text-success" style="width: 90px; height: 90px;">
                        <i class="fa-solid fa-circle-check" style="font-size: 50px;"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-dark mb-2">Đặt Hàng Thành Công!</h2>
                <p class="text-muted mb-4">Cảm ơn quý khách đã mua sắm tại <strong>LaptopShop</strong>. Đơn hàng của bạn đã được ghi nhận và đang được xử lý.</p>

                <div class="bg-light rounded-3 p-3 mb-4 border">
                    <span class="text-muted d-block small mb-1">Mã số đơn hàng của bạn:</span>
                    <span class="fs-4 fw-bold text-primary font-monospace">#@Model</span>
                    <div class="small text-secondary mt-1">Phương thức thanh toán: <strong>Thanh toán khi nhận hàng (COD)</strong></div>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a asp-controller="Orders" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                        <i class="fa-solid fa-box-archive me-1"></i> Theo dõi đơn hàng
                    </a>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold">
                        <i class="fa-solid fa-bag-shopping me-1"></i> Tiếp tục mua hàng
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>