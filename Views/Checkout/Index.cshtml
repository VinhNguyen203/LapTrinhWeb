@model LaptopShop.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    var cartItems = ViewBag.CartItems as List<LaptopShop.Models.CartItemViewModel> ?? new();
    decimal subtotal = ViewBag.Subtotal ?? 0;
}

<div class="container py-4">
    <!-- Tiêu đề trang -->
    <div class="d-flex align-items-center mb-4 border-bottom pb-3">
        <i class="fa-solid fa-credit-card fs-2 text-primary me-3"></i>
        <div>
            <h2 class="fw-bold mb-0 text-dark">Thanh Toán & Đặt Hàng</h2>
            <small class="text-muted">Kiểm tra thông tin giao hàng và áp dụng mã ưu đãi cho đơn hàng</small>
        </div>
    </div>

    <!-- Thông báo lỗi tổng quát nếu có -->
    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert alert-danger shadow-sm mb-4">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @Html.ValidationSummary(true, "", new { @class = "mb-0" })
        </div>
    }

    <form asp-action="Index" method="post" id="checkout-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CouponCode" id="hidden-coupon-code" />

        <div class="row g-4">
            <!-- CỘT TRÁI: THÔNG TIN GIAO HÀNG & PHƯƠNG THỨC THANH TOÁN (Col-lg-7) -->
            <div class="col-lg-7">
                <!-- Card 1: Thông tin nhận hàng -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">
                        <i class="fa-solid fa-truck-fast me-2"></i> 1. Thông Tin Nhận Hàng
                    </h5>

                    <div class="mb-3">
                        <label asp-for="CustomerName" class="form-label fw-semibold small">Họ và tên người nhận <span class="text-danger">*</span></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required />
                        <span asp-validation-for="CustomerName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold small">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                        <input asp-for="PhoneNumber" class="form-control" type="tel" placeholder="Ví dụ: 0912345678" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="form-label fw-semibold small">Địa chỉ nhận hàng chi tiết <span class="text-danger">*</span></label>
                        <textarea asp-for="ShippingAddress" class="form-control" rows="2" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..." required></textarea>
                        <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                    </div>

                    <div class="mb-0">
                        <label asp-for="OrderNotes" class="form-label fw-semibold small">Ghi chú giao hàng (Không bắt buộc)</label>
                        <input asp-for="OrderNotes" class="form-control" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi đến..." />
                    </div>
                </div>

                <!-- Card 2: Hình thức thanh toán -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">
                        <i class="fa-solid fa-wallet me-2"></i> 2. Phương Thức Thanh Toán
                    </h5>

                    <div class="d-flex flex-column gap-3">
                        <!-- Lựa chọn 1: COD -->
                        <div class="form-check p-3 border rounded-3 payment-option position-relative">
                            <input class="form-check-input ms-0 me-3" type="radio" asp-for="PaymentMethod" value="COD" id="payCOD" checked>
                            <label class="form-check-label w-100 cursor-pointer" for="payCOD">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="ms-4">
                                        <strong class="d-block text-dark">Thanh toán khi nhận hàng (COD)</strong>
                                        <small class="text-muted">Nhận máy, kiểm tra hàng kỹ lưỡng rồi mới thanh toán tiền mặt</small>
                                    </div>
                                    <i class="fa-solid fa-money-bill-wave text-success fs-3"></i>
                                </div>
                            </label>
                        </div>

                        <!-- Lựa chọn 2: Chuyển khoản QR -->
                        <div class="form-check p-3 border rounded-3 payment-option position-relative">
                            <input class="form-check-input ms-0 me-3" type="radio" asp-for="PaymentMethod" value="QR" id="payQR">
                            <label class="form-check-label w-100 cursor-pointer" for="payQR">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="ms-4">
                                        <strong class="d-block text-dark">Chuyển khoản Ngân hàng qua mã VietQR</strong>
                                        <small class="text-muted">Quét mã QR tự động điền số tiền và nội dung, xác nhận giao dịch tức thì</small>
                                    </div>
                                    <i class="fa-solid fa-qrcode text-primary fs-3"></i>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: TÓM TẮT ĐƠN HÀNG, COUPON & NÚT ĐẶT (Col-lg-5) -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 85px;">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">
                        <i class="fa-solid fa-receipt me-2 text-primary"></i> Tóm Tắt Đơn Hàng (@cartItems.Sum(i => i.Quantity) sản phẩm)
                    </h5>

                    <!-- Danh sách sản phẩm mua -->
                    <div class="cart-items-preview mb-3" style="max-height: 250px; overflow-y: auto;">
                        @foreach (var item in cartItems)
                        {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-secondary-subtle text-dark border">x@item.Quantity</span>
                                    <div>
                                        <div class="fw-semibold text-truncate text-dark small" style="max-width: 220px;" title="@item.ProductName">
                                            @item.ProductName
                                        </div>
                                        <small class="text-muted">@item.UnitPrice.ToString("N0") đ</small>
                                    </div>
                                </div>
                                <span class="fw-bold text-dark small">@item.TotalPrice.ToString("N0") đ</span>
                            </div>
                        }
                    </div>

                    <!-- Ô nhập mã giảm giá Coupon -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small"><i class="fa-solid fa-tag text-warning me-1"></i> Mã giảm giá / Voucher</label>
                        <div class="input-group">
                            <input type="text" id="coupon-input" class="form-control text-uppercase font-monospace fw-bold" placeholder="Nhập mã voucher..." />
                            <button type="button" id="btn-apply-coupon" class="btn btn-outline-primary fw-bold" onclick="applyCouponCode()">Áp dụng</button>
                        </div>
                        <div id="coupon-alert" class="small mt-1 d-none"></div>
                    </div>

                    <!-- Chi tiết số tiền -->
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-semibold">@subtotal.ToString("N0") đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2 text-success" id="discount-row" style="display: none !important;">
                        <span>Giảm giá voucher:</span>
                        <span class="fw-bold" id="discount-display">-0 đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Phí giao hàng:</span>
                        <span class="text-success fw-bold">Miễn phí toàn quốc</span>
                    </div>

                    <hr class="my-2" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-6">Tổng tiền thanh toán:</span>
                        <span class="fw-bold fs-4 text-danger" id="final-total-display">@subtotal.ToString("N0") đ</span>
                    </div>

                    <!-- Nút xác nhận đặt hàng -->
                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold fs-6 shadow-sm d-flex align-items-center justify-content-center gap-2" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: none;">
                        <i class="fa-solid fa-circle-check fs-5"></i>
                        <span>Xác Nhận Đặt Hàng</span>
                    </button>

                    <div class="text-center mt-3">
                        <a asp-controller="Cart" asp-action="Index" class="text-decoration-none small text-muted">
                            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại giỏ hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const initialSubtotal = @subtotal;

        function applyCouponCode() {
            const codeInput = document.getElementById("coupon-input");
            const code = codeInput ? codeInput.value.trim() : "";
            const alertBox = document.getElementById("coupon-alert");
            const discountRow = document.getElementById("discount-row");
            const discountDisplay = document.getElementById("discount-display");
            const finalDisplay = document.getElementById("final-total-display");
            const hiddenCoupon = document.getElementById("hidden-coupon-code");
            const btnApply = document.getElementById("btn-apply-coupon");

            if (!code) {
                alertBox.className = "small mt-1 text-danger";
                alertBox.textContent = "Vui lòng nhập mã giảm giá.";
                alertBox.classList.remove("d-none");
                return;
            }

            btnApply.disabled = true;
            btnApply.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';

            const formData = new FormData();
            formData.append("code", code);

            fetch('/Checkout/CheckCoupon', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alertBox.className = "small mt-1 text-success fw-semibold";
                    alertBox.textContent = data.message;
                    alertBox.classList.remove("d-none");

                    discountRow.style.removeProperty("display");
                    discountRow.style.display = "flex";
                    discountDisplay.textContent = "-" + Number(data.discountAmount).toLocaleString('vi-VN') + " đ";
                    finalDisplay.textContent = Number(data.finalTotal).toLocaleString('vi-VN') + " đ";
                    hiddenCoupon.value = data.code;
                } else {
                    alertBox.className = "small mt-1 text-danger";
                    alertBox.textContent = data.message;
                    alertBox.classList.remove("d-none");

                    discountRow.style.setProperty("display", "none", "important");
                    finalDisplay.textContent = initialSubtotal.toLocaleString('vi-VN') + " đ";
                    hiddenCoupon.value = "";
                }
            })
            .catch(() => {
                alertBox.className = "small mt-1 text-danger";
                alertBox.textContent = "Không thể kiểm tra mã vào lúc này.";
                alertBox.classList.remove("d-none");
            })
            .finally(() => {
                btnApply.disabled = false;
                btnApply.innerHTML = 'Áp dụng';
            });
        }
    </script>
}