@model LaptopShop.Helpers.PaginatedList<LaptopShop.Models.Product>

@{
    ViewData["Title"] = "Danh Sách Laptop & Tìm Kiếm Nâng Cao";
    var brands = ViewBag.Brands as List<LaptopShop.Models.Brand> ?? new();
    var categories = ViewBag.Categories as List<LaptopShop.Models.Category> ?? new();
    var rams = ViewBag.AvailableRams as List<string> ?? new();
    var pagination = ViewBag.Pagination as LaptopShop.Models.PaginationInfo;
}

<style>
    body {
        background: linear-gradient(180deg, #f8fafc 0%, #ede9fe 100%);
        min-height: 100vh;
    }
    .filter-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        border: 1px solid #e2e8f0;
    }
    .fw-extrabold {
        font-weight: 800;
    }
    .filter-label {
        color: #0f172a !important;
        font-weight: 700 !important;
        font-size: 0.88rem !important;
        margin-bottom: 0.35rem;
    }
    .filter-select {
        color: #0f172a !important;
        font-weight: 600 !important;
        border: 1.5px solid #cbd5e1 !important;
        background-color: #f8fafc !important;
    }
    .filter-select:focus {
        border-color: #4f46e5 !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15) !important;
    }
</style>

<div class="container py-4">
    
    <!-- Tiêu đề trang tương phản cao -->
    <div class="d-flex justify-content-between align-items-center mb-4 px-2 border-bottom pb-3" style="border-color: #cbd5e1 !important;">
        <div>
            <span class="text-uppercase fw-extrabold small d-block mb-1" style="color: #4f46e5; letter-spacing: 0.15em;">
                Bộ sưu tập công nghệ 2026
            </span>
            <h2 class="fw-extrabold mb-0" style="color: #0f172a; font-size: 2rem;">
                Danh Sách Sản Phẩm Laptop <i class="fa-solid fa-layer-group text-warning ms-1"></i>
            </h2>
        </div>
        <span class="badge px-3 py-2 rounded-pill fs-6 fw-bold" style="background: #1e293b; color: #ffffff;">
            Tìm thấy @Model.TotalCount sản phẩm
        </span>
    </div>

    <!-- HỆ THỐNG BỘ LỌC & TÌM KIẾM NÂNG CAO (CHỮ TƯƠNG PHẢN CAO, SIÊU DỄ NHÌN) -->
    <div class="filter-card p-4 mb-4">
        <form asp-action="Index" method="get" id="filterForm">
            <!-- Hàng 1: Ô tìm kiếm từ khóa chính -->
            <div class="row g-3 mb-3">
                <div class="col-lg-8">
                    <div class="input-group input-group-lg shadow-sm">
                        <span class="input-group-text bg-white border-end-0 ps-3" style="border: 1.5px solid #cbd5e1; border-right: none;">
                            <i class="fa-solid fa-magnifying-glass text-primary fs-5"></i>
                        </span>
                        <input type="text" name="searchTerm" class="form-control border-start-0 ps-2 fs-6 fw-semibold" 
                               style="border: 1.5px solid #cbd5e1; border-left: none; color: #0f172a;"
                               placeholder="Tìm theo tên máy, CPU, GPU, RAM (ví dụ: ASUS, RTX 4060, i7, 16GB)..." 
                               value="@ViewBag.CurrentSearch" />
                    </div>
                </div>
                <div class="col-lg-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1 shadow-sm fw-extrabold" style="background: #4338ca; border: none;">
                        <i class="fa-solid fa-filter me-1"></i> Tìm Kiếm & Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-dark btn-lg px-3 shadow-sm fw-bold" style="border: 1.5px solid #94a3b8; color: #0f172a;" title="Đặt lại bộ lọc">
                        <i class="fa-solid fa-rotate-right"></i>
                    </a>
                </div>
            </div>

            <!-- Hàng 2: Các tiêu chí lọc chi tiết -->
            <div class="row g-3">
                <!-- Lọc theo Hãng / Thương hiệu -->
                <div class="col-md-3 col-sm-6">
                    <label class="form-label filter-label">
                        <i class="fa-solid fa-tags text-primary me-1"></i>Hãng sản xuất
                    </label>
                    <select name="brandId" class="form-select filter-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">-- Tất cả các Hãng --</option>
                        @foreach (var b in brands)
                        {
                            <option value="@b.Id" selected="@(ViewBag.CurrentBrandId == b.Id ? "selected" : null)">@b.Name</option>
                        }
                    </select>
                </div>

                <!-- Lọc theo Danh mục sản phẩm -->
                <div class="col-md-3 col-sm-6">
                    <label class="form-label filter-label">
                        <i class="fa-solid fa-list text-primary me-1"></i>Danh mục sản phẩm
                    </label>
                    <select name="categoryId" class="form-select filter-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">-- Tất cả Danh mục --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id" selected="@(ViewBag.CurrentCategoryId == c.Id ? "selected" : null)">@c.Name</option>
                        }
                    </select>
                </div>

                <!-- Lọc theo Dung lượng RAM -->
                <div class="col-md-2 col-sm-6">
                    <label class="form-label filter-label">
                        <i class="fa-solid fa-memory text-primary me-1"></i>Bộ nhớ RAM
                    </label>
                    <select name="ram" class="form-select filter-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">-- Tất cả RAM --</option>
                        @foreach (var r in rams)
                        {
                            <option value="@r" selected="@(ViewBag.CurrentRam == r ? "selected" : null)">@r</option>
                        }
                    </select>
                </div>

                <!-- Lọc theo Khoảng giá -->
                <div class="col-md-2 col-sm-6">
                    <label class="form-label filter-label">
                        <i class="fa-solid fa-money-bill-wave text-primary me-1"></i>Mức giá
                    </label>
                    <select name="priceRange" class="form-select filter-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="">-- Chọn mức giá --</option>
                        <option value="under-15" selected="@(ViewBag.CurrentPriceRange == "under-15" ? "selected" : null)">Dưới 15 triệu</option>
                        <option value="15-25" selected="@(ViewBag.CurrentPriceRange == "15-25" ? "selected" : null)">15 - 25 triệu</option>
                        <option value="25-35" selected="@(ViewBag.CurrentPriceRange == "25-35" ? "selected" : null)">25 - 35 triệu</option>
                        <option value="over-35" selected="@(ViewBag.CurrentPriceRange == "over-35" ? "selected" : null)">Trên 35 triệu</option>
                    </select>
                </div>

                <!-- Sắp xếp kết quả -->
                <div class="col-md-2 col-sm-6">
                    <label class="form-label filter-label">
                        <i class="fa-solid fa-arrow-down-short-wide text-primary me-1"></i>Sắp xếp theo
                    </label>
                    <select name="sortBy" class="form-select filter-select" onchange="document.getElementById('filterForm').submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.CurrentSortBy) ? "selected" : null)">Mới nhất</option>
                        <option value="price_asc" selected="@(ViewBag.CurrentSortBy == "price_asc" ? "selected" : null)">Giá: Thấp đến Cao</option>
                        <option value="price_desc" selected="@(ViewBag.CurrentSortBy == "price_desc" ? "selected" : null)">Giá: Cao đến Thấp</option>
                        <option value="name_asc" selected="@(ViewBag.CurrentSortBy == "name_asc" ? "selected" : null)">Tên: A -> Z</option>
                    </select>
                </div>
            </div>
        </form>
    </div>

    <!-- Thông báo kết quả giỏ hàng (nếu có thêm bằng ajax) -->
    <div id="cart-message" class="d-none"></div>

    <!-- LƯỚI SẢN PHẨM HIỂN THỊ DÙNG PARTIAL _ProductCard -->
    <div class="row g-4 mb-5">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <partial name="_ProductCard" model="item" />
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="bg-white rounded-4 p-5 shadow-sm border" style="border-color: #cbd5e1;">
                    <i class="fa-solid fa-box-open fs-1 text-primary mb-3 d-block"></i>
                    <h3 class="fw-extrabold mb-2" style="color: #0f172a;">Không tìm thấy sản phẩm nào phù hợp!</h3>
                    <p class="text-secondary mb-4 fs-6">Vui lòng thử lại với từ khóa khác hoặc bấm nút bên dưới để bỏ các tiêu chí lọc giá / RAM / thương hiệu.</p>
                    <a asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-extrabold" style="background: #4338ca; border: none;">
                        <i class="fa-solid fa-rotate-left me-1"></i> Xóa tất cả bộ lọc & Hiển thị lại
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- PHÂN TRANG DÙNG PARTIAL _Pagination -->
    @if (pagination != null)
    {
        <partial name="_Pagination" model="pagination" />
    }

</div>

@section Scripts {
    <script src="~/js/cart.js?v=@DateTime.UtcNow.Ticks" asp-append-version="true"></script>
}