@model LaptopShop.Models.Product
@{
    ViewData["Title"] = Model.Name + " - LaptopShop";
    var relatedProducts = ViewBag.RelatedProducts as List<LaptopShop.Models.Product>;
    var originalPrice = Model.Price * 1.15m;
    var discountAmount = originalPrice - Model.Price;
    bool isOutOfStock = Model.StockQuantity <= 0;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="fa-solid fa-house me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item"><a href="/Products" class="text-decoration-none text-muted">Sản phẩm laptop</a></li>
            @if (Model.Brand != null)
            {
                <li class="breadcrumb-item"><a href="/Products?brandId=@Model.BrandId" class="text-decoration-none text-muted">@Model.Brand.Name</a></li>
            }
            <li class="breadcrumb-item active fw-semibold text-primary" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Khối Chi Tiết Sản Phẩm Chính -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 mb-5 bg-white">
        <div class="row g-5">
            <!-- Cột Trái: HÌNH ẢNH SẢN PHẨM & BADGES -->
            <div class="col-lg-5">
                <div class="position-sticky" style="top: 90px;">
                    <div class="text-center p-5 rounded-4 mb-4 position-relative overflow-hidden" 
                         style="background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%); min-height: 380px; display: flex; align-items: center; justify-content: center;">
                        
                        <!-- Badge giảm giá -->
                        <span class="badge text-white px-3 py-2 rounded-pill fw-bold shadow-sm position-absolute top-0 start-0 m-3" 
                              style="background: linear-gradient(135deg, #ff416c, #ff4b2b);">
                            -15% GIẢM SỐC
                        </span>

                        <!-- Badge thương hiệu -->
                        @if (Model.Brand != null)
                        {
                            <span class="badge bg-dark text-white px-3 py-2 rounded-3 small position-absolute top-0 end-0 m-3 shadow-sm">
                                @Model.Brand.Name
                            </span>
                        }

                        <div class="py-4">
                            <i class="fa-solid fa-laptop text-primary" style="font-size: 130px; filter: drop-shadow(0 15px 30px rgba(99, 102, 241, 0.3));"></i>
                        </div>

                        <span class="badge bg-white text-primary border position-absolute bottom-0 end-0 m-3 px-3 py-2 rounded-pill small shadow-sm fw-semibold">
                            <i class="fa-solid fa-shield-halved me-1"></i>Chính Hãng 100%
                        </span>
                    </div>

                    <!-- 3 Khối cam kết dưới ảnh -->
                    <div class="row g-2 text-center small text-muted">
                        <div class="col-4">
                            <div class="bg-light p-2 rounded-3 border">
                                <i class="fa-solid fa-box-open text-primary mb-1 d-block fa-lg"></i>
                                Mới 100% Fullbox
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-light p-2 rounded-3 border">
                                <i class="fa-solid fa-rotate-left text-success mb-1 d-block fa-lg"></i>
                                1 đổi 1 30 ngày
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-light p-2 rounded-3 border">
                                <i class="fa-solid fa-screwdriver-wrench text-warning mb-1 d-block fa-lg"></i>
                                Bảo hành 24T
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột Phải: THÔNG TIN SẢN PHẨM & MUA HÀNG -->
            <div class="col-lg-7">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @if (Model.Brand != null)
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold">
                            <i class="fa-solid fa-building me-1"></i>@Model.Brand.Name
                        </span>
                    }
                    @if (Model.Category != null)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold">
                            <i class="fa-solid fa-layer-group me-1"></i>@Model.Category.Name
                        </span>
                    }
                </div>

                <h2 class="fw-extrabold text-dark mb-3">@Model.Name</h2>

                <!-- Đánh giá sao -->
                <div class="d-flex align-items-center gap-3 mb-4 text-warning small">
                    <div>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <i class="fa-solid fa-star"></i>
                        <span class="text-dark fw-bold ms-1">5.0</span>
                    </div>
                    <span class="text-muted">|</span>
                    <span class="text-muted">Mã SP: #@Model.Id</span>
                    <span class="text-muted">|</span>
                    @if (!isOutOfStock)
                    {
                        <span class="text-success fw-semibold"><i class="fa-solid fa-circle-check me-1"></i>Còn hàng trong kho (@Model.StockQuantity chiếc)</span>
                    }
                    else
                    {
                        <span class="text-danger fw-semibold"><i class="fa-solid fa-circle-xmark me-1"></i>Tạm hết hàng</span>
                    }
                </div>

                <!-- Khung Giá Bán -->
                <div class="p-3 rounded-4 mb-4" style="background: linear-gradient(135deg, #fff1f2 0%, #ede9fe 100%); border: 1px solid rgba(244, 63, 94, 0.15);">
                    <div class="d-flex align-items-baseline gap-3">
                        <span class="text-danger fw-extrabold display-5">@Model.Price.ToString("N0") VNĐ</span>
                        <del class="text-muted fs-5 text-decoration-line-through">@originalPrice.ToString("N0") VNĐ</del>
                    </div>
                    <div class="text-success small fw-semibold mt-1">
                        <i class="fa-solid fa-tags me-1"></i>Tiết kiệm ngay: @discountAmount.ToString("N0") VNĐ (Giá đã bao gồm VAT)
                    </div>
                </div>

                <!-- Cấu hình nổi bật -->
                <div class="card bg-light border-0 rounded-4 p-3 mb-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-microchip text-primary me-2"></i>Cấu Hình Phần Cứng Tóm Tắt:</h6>
                    <div class="row g-2 small">
                        <div class="col-sm-6">
                            <div class="p-2 bg-white rounded-3 border">
                                <span class="text-muted d-block">Bộ vi xử lý (CPU):</span>
                                <strong class="text-dark">@(Model.CPU ?? "Đang cập nhật")</strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-2 bg-white rounded-3 border">
                                <span class="text-muted d-block">Bộ nhớ RAM:</span>
                                <strong class="text-dark">@(Model.RAM ?? "Đang cập nhật")</strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-2 bg-white rounded-3 border">
                                <span class="text-muted d-block">Card đồ họa (GPU):</span>
                                <strong class="text-dark">@(Model.GPU ?? "Card đồ họa tích hợp")</strong>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="p-2 bg-white rounded-3 border">
                                <span class="text-muted d-block">Thương hiệu / Xuất xứ:</span>
                                <strong class="text-dark">@(Model.Brand?.Name ?? "Chính hãng")</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Khuyến mãi đi kèm -->
                <div class="p-3 rounded-4 mb-4 border border-warning bg-warning bg-opacity-10">
                    <h6 class="fw-bold text-warning-emphasis mb-2">
                        <i class="fa-solid fa-gift me-2 text-warning"></i>Quà Tặng & Ưu Đãi Độc Quyền:
                    </h6>
                    <ul class="mb-0 small text-dark ps-3">
                        <li>Tặng Balo laptop chuyên dụng cao cấp trị giá 450.000₫</li>
                        <li>Tặng Chuột không dây Logitech & Lót chuột chống mỏi</li>
                        <li>Cài đặt hệ điều hành Windows bản quyền & vệ sinh máy trọn đời</li>
                        <li>Giảm thêm 300.000₫ cho Học sinh - Sinh viên khi mua hàng</li>
                    </ul>
                </div>

                <!-- Nút Hành Động Mua Hàng -->
                <div class="d-flex flex-wrap gap-3 pt-2">
                    <button type="button" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-lg flex-grow-1" 
                            style="background: linear-gradient(135deg, #ef4444, #dc2626); border: none;"
                            @(isOutOfStock ? "disabled" : "")>
                        <i class="fa-solid fa-bolt me-2"></i>MUA NGAY (GIAO HỎA TỐC 2H)
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-lg rounded-pill px-4 fw-bold" 
                            @(isOutOfStock ? "disabled" : "")>
                        <i class="fa-solid fa-cart-plus me-2"></i>Thêm Vào Giỏ
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Khối Bảng Thông Số Kỹ Thuật Chi Tiết -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-lg-5 mb-5 bg-white">
        <h4 class="fw-bold text-dark mb-4 border-bottom pb-3">
            <i class="fa-solid fa-list-check text-primary me-2"></i>Bảng Thông Số Kỹ Thuật Chi Tiết
        </h4>
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <tbody>
                    <tr>
                        <th style="width: 250px;" class="text-muted fw-semibold ps-3">Tên sản phẩm</th>
                        <td class="fw-bold text-dark">@Model.Name</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold ps-3">Hãng sản xuất</th>
                        <td>@(Model.Brand?.Name ?? "Chưa phân loại")</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold ps-3">Phân loại nhu cầu</th>
                        <td>@(Model.Category?.Name ?? "Chưa phân loại")</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold ps-3">Bộ vi xử lý (CPU)</th>
                        <td>@(Model.CPU ?? "Đang cập nhật")</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold ps-3">Bộ nhớ RAM</th>
                        <td>@(Model.RAM ?? "Đang cập nhật")</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold ps-3">Xử lý đồ họa (GPU)</th>
                        <td>@(Model.GPU ?? "Card đồ họa tích hợp")</td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold ps-3">Tình trạng tồn kho</th>
                        <td>
                            @if (!isOutOfStock)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-1">Còn @Model.StockQuantity sản phẩm</span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-1">Hết hàng</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <th class="text-muted fw-semibold ps-3">Chính sách bảo hành</th>
                        <td>Bảo hành chính hãng 24 tháng tận nhà từ nhà sản xuất</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Khối Sản Phẩm Tương Tự / Gợi Ý Cùng Hãng Hoặc Danh Mục -->
    @if (relatedProducts != null && relatedProducts.Any())
    {
        <div class="mb-5">
            <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
                <div>
                    <span class="text-uppercase fw-bold text-primary small">Gợi Ý Cho Bạn</span>
                    <h3 class="fw-bold mb-0 text-dark">Sản Phẩm Cùng Phân Khúc</h3>
                </div>
                <a href="/Products" class="btn btn-outline-primary rounded-pill px-4 fw-semibold btn-sm">
                    Xem tất cả <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
            <div class="row g-4">
                @foreach (var related in relatedProducts)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        @await Html.PartialAsync("_ProductCard", related)
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .fw-extrabold {
        font-weight: 800;
    }
</style>
