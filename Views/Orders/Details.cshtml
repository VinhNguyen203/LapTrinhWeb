@model LaptopShop.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">Chi tiết Đơn hàng: #@Model.Id</h2>
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>

    <div class="row">
        <!-- Cột thông tin khách hàng -->
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Thông tin Khách hàng</h5>
                </div>
                <div class="card-body">
                    <p><strong>Họ tên:</strong> @Model.CustomerName</p>
                    <p><strong>Điện thoại:</strong> @Model.PhoneNumber</p>
                    <p><strong>Địa chỉ giao:</strong> @Model.ShippingAddress</p>
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p>
                        <strong>Trạng thái:</strong>
                        <span class="badge bg-warning text-dark">@Model.Status</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Cột danh sách sản phẩm -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Sản phẩm đã đặt</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                var lineTotal = detail.Quantity * detail.UnitPrice;
                                <tr>
                                    <td>
                                        <!-- Nếu có tên sản phẩm thì in ra, không có thì in 'Sản phẩm đã xóa' -->
                                        @(detail.Product != null ? detail.Product.Name : "Sản phẩm không xác định")
                                    </td>
                                    <td class="text-center">@detail.Quantity</td>
                                    <td class="text-end text-danger">@detail.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-end text-danger fw-bold">@lineTotal.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Tổng thanh toán:</td>
                                <td class="text-end text-danger fw-bold fs-5">@Model.TotalAmount.ToString("N0") VNĐ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>